            "name": "DP04_0058PM"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    mp_otherrace",
          "description": "Adjunct variable - Percentage of some other race, not Hispanic or Latino persons estimate MOE, 2016-2020 ACS",
