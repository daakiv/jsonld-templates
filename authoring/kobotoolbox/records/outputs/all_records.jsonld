    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_distritos_minam",
      "name": "Límite Distrital Huayhuash (MINAM)",
      "description": "Las delimitaciones de los distritos del Perú",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "2.0M"
        },
        {
          "@type": "PropertyValue",
