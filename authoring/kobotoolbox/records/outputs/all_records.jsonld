      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_municipal_park_boundaries",
      "name": "Miami-Dade County Municipal Park Boundaries",
      "description": "A polygon feature class of Miami-Dade Municipal (Incorporated) Maintained Parks and Recreational boundary.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
