    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_2022_svi_tract",
      "name": "2022 Miami-Dade CDC Social Vulnerability Index (tracts)",
      "description": "Social vulnerability refers to the potential negative effects on communities caused by external stresses on human health. Such stresses include natural or human-caused disasters, or disease outbreaks. Reducing social vulnerability can decrease both human suffering and economic loss.\n  \n  The CDC/ATSDR Social Vulnerability Index (CDC/ATSDR SVI) uses 16 U.S. census variables to help local officials identify communities that may need support before, during, or after disasters.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "0"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_2022_svi_tract"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "143"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2022_svi_tract/download -p /data/mdc_2022_svi_tract/etl\n  chmod 777 /data/mdc_2022_svi_tract/download\n  cd /data/mdc_2022_svi_tract\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # load fl_2022_svi_tract as dependency (see fl_2022_svi_tract for details).\n  \n  # Create copy of geom dependency\n  pg_dump -d $POSTGRES_DB -U $POSTGRES_USER -p $POSTGRES_PORT -h gdsc-postgis-node-3vuojj3i3utqwxih -t fl_2022_svi_tract | sed 's/fl_2022_svi_tract/mdc_2022_svi_tract/g' | psql -d $POSTGRES_DB -U $POSTGRES_USER -p $POSTGRES_PORT -h gdsc-postgis-node-sxztgqd6071bq4ie \n  \n  # drop geom_local and subset as per custom parameters\n  psql -d $POSTGRES_DB -U $POSTGRES_USER -p $POSTGRES_PORT -h gdsc-postgis-node-sxztgqd6071bq4ie -c \"\n  ALTER TABLE mdc_2022_svi_tract DROP COLUMN IF EXISTS geom_local;\n  DELETE FROM mdc_2022_svi_tract\n    WHERE NOT (stcnty = '12086');\n  COMMIT;\"\n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_2022_svi_tract',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_2022_svi_tract\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_2022_svi_tract_geom_local_idx\n    ON mdc_2022_svi_tract\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_2022_svi_tract',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_2022_svi_tract\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_2022_svi_tract_geom_local_idx\n    ON mdc_2022_svi_tract\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_2022_svi_tract/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/mdc_2022_svi_tract.shp PG:\"<postgres connection>\" mdc_2022_svi_tract\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/mdc_2022_svi_tract.shp.tar.gz\n  tar -czf derived/mdc_2022_svi_tract.shp.tar.gz meta_dcat_mdc_2022_svi_tract.json -C derived mdc_2022_svi_tract.shp mdc_2022_svi_tract.prj mdc_2022_svi_tract.shx mdc_2022_svi_tract.dbf\n  \n  # Move into correct directory\n  cd /data/mdc_2022_svi_tract/"
        },
