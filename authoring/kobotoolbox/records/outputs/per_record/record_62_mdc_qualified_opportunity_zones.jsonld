  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_qualified_opportunity_zones",
      "name": "Miami-Dade Qualified Opportunity Zones",
      "description": "A polygon feature class with all population census tracts designated as Qualified Opportunity Zones (QOZs) as well as all population census tracts originally eligible for designation as a QOZ for purposes of 1400Z1 and 1400Z2 of the Internal Revenue Code (the Code). To identify areas designated as Qualified Opportunity Zones (QOZs). An Opportunity Zone is an economically-distressed community where new investments, under certain conditions, may be eligible for preferential tax treatment.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "262K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_qualified_opportunity_zones"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "62"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_qualified_opportunity_zones/download -p /data/mdc_qualified_opportunity_zones/etl\n  chmod 777 /data/mdc_qualified_opportunity_zones/download\n  cd /data/mdc_qualified_opportunity_zones\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_qualified_opportunity_zones.json 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/QualifiedOpportunityZones_gdb/FeatureServer/0/query?outFields=*&where=1%3D1&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_qualified_opportunity_zones.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_qualified_opportunity_zones.json -nlt multipolygon -nln mdc_qualified_opportunity_zones\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_qualified_opportunity_zones\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_qualified_opportunity_zones',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_qualified_opportunity_zones\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_qualified_opportunity_zones_geom_local_idx\n    ON mdc_qualified_opportunity_zones\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_qualified_opportunity_zones/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_qualified_opportunity_zones/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-htibusvpm7rorahm -t mdc_qualified_opportunity_zones > derived/mdc_qualified_opportunity_zones.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_qualified_opportunity_zones.sql.tar.gz\n  tar -czf derived/mdc_qualified_opportunity_zones.sql.tar.gz meta_dcat_mdc_qualified_opportunity_zones.json -C derived mdc_qualified_opportunity_zones.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "namelsad10"
        },
        {
