  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_state_and_national_parks",
      "name": "MDC State and National Parks",
      "description": "The State Parks are derived as a subset from The Florida Natural Areas Inventory. The Florida Natural Areas Inventory is the primary source for information on Florida's conservation lands. FNAI's database includes boundaries and statistics for more than 2,900 federal, state, local, and private managed areas, all provided directly by the managing agencies. National parks, state forests, wildlife management areas, local and private preserves are examples of the managed areas included. The shapefile is called FLMA for Florida Managed Areas; updated versions are published quarterly.\n  \n  FLORIDA CONSERVATION LANDS (layer name FLMA): This is a polygon data layer for public (and some private) lands that the Florida Natural Areas Inventory (FNAI) has identified as having natural resource value and that are being managed at least partially for conservation purposes. The term \"Managed Area\" refers to a managed conservation land.\n  ",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "0"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_state_and_national_parks"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "233"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_state_and_national_parks/download -p /data/mdc_state_and_national_parks/etl\n  chmod 777 /data/mdc_state_and_national_parks/download\n  cd /data/mdc_state_and_national_parks\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # load fl_2026_flma as dependency (see fl_2026_flma for details).\n  \n  # Create copy of geom dependency\n  pg_dump -d $POSTGRES_DB -U $POSTGRES_USER -p $POSTGRES_PORT -h gdsc-postgis-node-1jeve09m3vekcikq -t fl_2026_flma | sed 's/fl_2026_flma/mdc_state_and_national_parks/g' | psql -d $POSTGRES_DB -U $POSTGRES_USER -p $POSTGRES_PORT -h gdsc-postgis-node-6le21zztz8dq9r60 \n  \n  # drop geom_local and subset as per custom parameters\n  psql -d $POSTGRES_DB -U $POSTGRES_USER -p $POSTGRES_PORT -h gdsc-postgis-node-6le21zztz8dq9r60 -c \"\n  ALTER TABLE mdc_state_and_national_parks DROP COLUMN IF EXISTS geom_local;\n  DELETE FROM mdc_state_and_national_parks\n    WHERE NOT ((matype = 'FNPNP' OR matype = 'SRPRA') AND county = 'DADE'\n  );\n  COMMIT;\"\n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_state_and_national_parks',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_state_and_national_parks\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_state_and_national_parks_geom_local_idx\n    ON mdc_state_and_national_parks\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_state_and_national_parks',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_state_and_national_parks\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_state_and_national_parks_geom_local_idx\n    ON mdc_state_and_national_parks\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
