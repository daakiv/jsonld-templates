      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/fl_us_highways",
      "name": "Florida US Highways",
      "description": "Location of US Routes in the state of Florida as derived from even mapping",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "1.9M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "fl_us_highways"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "42"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/fl_us_highways/download -p /data/fl_us_highways/etl\n  chmod 777 /data/fl_us_highways/download\n  cd /data/fl_us_highways\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/fl_us_highways.json 'https://services1.arcgis.com/O1JpcwDW8sjYuddV/arcgis/rest/services/US_Routes_TDA/FeatureServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=json'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/fl_us_highways.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/fl_us_highways.json -nlt multilinestring -nln fl_us_highways\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE fl_us_highways\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'fl_us_highways',\n    'geom_local', 2236, 'multilinestring', 2\n  );\n  UPDATE fl_us_highways\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX fl_us_highways_geom_local_idx\n    ON fl_us_highways\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/fl_us_highways/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/fl_us_highways/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-node-au7rbwee3k8vte4f -t fl_us_highways > derived/fl_us_highways.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/fl_us_highways.sql.tar.gz\n  tar -czf derived/fl_us_highways.sql.tar.gz meta_dcat_fl_us_highways.json -C derived fl_us_highways.sql"
        },
        {
