    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_flood_hazard",
      "name": "Miami-Dade Flood Hazard (FEMA)",
      "description": "A polygon feature class of Federal Emergency Management Agency (FEMA) flood hazard zones within Miami-Dade County",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "345M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_flood_hazard"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "53"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_flood_hazard/download -p /data/mdc_flood_hazard/etl\n  chmod 777 /data/mdc_flood_hazard/download\n  cd /data/mdc_flood_hazard\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_flood_hazard.json 'https://opendata.arcgis.com/api/v3/datasets/ef3bdd041b2e424695eb4dfe965966c4_0/downloads/data?format=geojson&spatialRefId=4326&where=1%3D1'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_flood_hazard.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_flood_hazard.json -nlt multipolygon -nln mdc_flood_hazard\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_flood_hazard\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_flood_hazard',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_flood_hazard\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_flood_hazard_geom_local_idx\n    ON mdc_flood_hazard\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_flood_hazard/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_flood_hazard/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-kqhd5rfs28u3lfsw -t mdc_flood_hazard > derived/mdc_flood_hazard.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_flood_hazard.sql.tar.gz\n  tar -czf derived/mdc_flood_hazard.sql.tar.gz meta_dcat_mdc_flood_hazard.json -C derived mdc_flood_hazard.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
