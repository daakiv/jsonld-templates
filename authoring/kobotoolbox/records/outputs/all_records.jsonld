          "name": "source_file",
          "value": "{'etl_group/file_name_group/file_inside_archive': 'VNP46A4.A2016001.h09v06.002.2025102105339', 'etl_group/file_name_group/file_name_value': 'mdc_2016_viirs_vnp46a4'}"
        },
        {
          "@type": "PropertyValue",
