          "name": "source_file",
          "value": "{'etl_group/file_name_group/file_inside_archive': 'VNP46A4.A2013001.h09v06.002.2025087045108', 'etl_group/file_name_group/file_name_value': 'mdc_2013_viirs_vnp46a4'}"
        },
