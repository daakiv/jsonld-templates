    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_2021_ndvi_greenness_30m",
      "name": "2021 Miami-Dade NDVI",
      "description": "Greenness measured as a recentered NDVI (Normalized Difference Vegetation Index) moved from -1:1 to 1-100.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "510M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_2021_ndvi_greenness_30m"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "15"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "person"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2021_hylo/download -p /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/etl\n  chmod 777 /data/mdc_2021_hylo/download\n  cd /data/mdc_2021_hylo\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_2021_hylo.zip 'https://scholarship.miami.edu/view/fileRedirect?instCode=01UOML_INST&filePid=13395678880002976&download=true'\n  \n  # unzip to download directory if update flag is set\n  if do_update == 1 then\n  unzip -d download download/mdc_2021_hylo.zip && rm download/mdc_2021_hylo.zip\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 3857 -d -C -I -t 48x48 GeoTIFF_Rasters/Greenness_30m_MDC.tif -F mdc_2021_ndvi_greenness_30m > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # create color raster\n  mkdir -p /tiles/raster/mdc_2021_ndvi_greenness_30m\n  mkdir -p /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/derived\n  cd /data/mdc_2021_hylo\n  cat > /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/derived/mdc_2021_ndvi_greenness_30m_color_ramp.txt <<_EOF\n  nv 0 0 0 0\n  178 0 68 27 255\n  160.2 0 109 44 255\n  142.4 29 134 65 255\n  124.6 53 159 84 255\n  106.8 85 181 103 255\n  89 123 199 124 255\n  71.2 158 215 152 255\n  53.4 187 228 181 255\n  35.6 213 239 207 255\n  17.8 233 247 229 255\n  1 247 252 245 255\n  0 0 0 0 0\n  _EOF\n  gdaldem color-relief download/GeoTIFF_Rasters/Greenness_30m_MDC.tif /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/derived/mdc_2021_ndvi_greenness_30m_color_ramp.txt /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/derived/mdc_2021_ndvi_greenness_30m_color.tif -alpha\n  # create color raster and render raster tiles \n  mkdir -p /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/derived\n  mkdir -p /tiles/raster/mdc_2021_ndvi_greenness_30m\n  cd /data/mdc_2021_hylo\n  echo \"\" | base64 -d > /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/derived/mdc_2021_ndvi_greenness_30m_legend.png\n  cp /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/derived/mdc_2021_ndvi_greenness_30m_legend.png /tiles/raster/mdc_2021_ndvi_greenness_30m/\n  # render raster tiles \n  cd /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/\n  gdal2tiles.py -ex --xyz -z 8-16 /data/mdc_2021_hylo/mdc_2021_ndvi_greenness_30m/derived/mdc_2021_ndvi_greenness_30m_color.tif /tiles/raster/mdc_2021_ndvi_greenness_30m"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "analytic_function",
          "value": "gdsc_zonal_statistics"
        },
        {
          "@type": "PropertyValue",
          "name": "Spatial Reference System",
          "value": "http://www.opengis.net/def/crs/EPSG/0/2236"
        },
