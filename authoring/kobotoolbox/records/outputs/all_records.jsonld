            "@type": "Organization",
            "name": "DP05_0081PM"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    mp_nohsdp",
          "description": "Percentage of persons with no high school diploma (25+) estimate MOE",
          "qudt:dataType": "xsd:float8",
          "unitText": "moe",
          "sourceOrganization": {
            "@type": "Organization",
            "name": "S0601_C01_033M"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    mp_noint",
          "description": "Adjunct variable - Percentage of households without a computer with a broadband Internet subscription estimate MOE, 2016-2020 ACS",
          "qudt:dataType": "xsd:float8",
          "unitText": "moe",
          "sourceOrganization": {
            "@type": "Organization",
            "name": "((SQRT (M_NOINT^2 - ((EP_NOINT / 100)^2 * S2802_C01_001M^2))) / S2802_C01_001M) * 100"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    mp_noveh",
