  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_2015_dem_100ft",
      "name": "2015 Miami-Dade County DEM 100ft",
      "description": "This dataset is derived from the 2015 Miami-Dade County DEM 10ft layer found at https://gis-mdc.opendata.arcgis.com/documents/MDC::2015-miami-dade-county-dem-10ft/about. The original source data was resampled to a resolution of 30ft per pixel using the gdalwarp utility.\n  \n  This source from Miami-Dade County a Digital Elevation Model (DEM) as a raster mosaic in ESRI float format 32bit representation on a 10ft grid created from the LiDAR collected for the 2015 ITD LiDAR project.\n  \n  Bare-earth 10-foot DEM as 32-bit floating point raster format in ArcGIS GRID Raster format in compliance with USGS LIDAR Base Specifications: georeferencing information, delivered without overlap and with no edge artifacts or mismatched, “NODATA” value for void areas, bridges removed from the surface, etc.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "29M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_2015_dem_100ft"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "85"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2015_dem_100ft/download -p /data/mdc_2015_dem_100ft/etl\n  chmod 777 /data/mdc_2015_dem_100ft/download\n  cd /data/mdc_2015_dem_100ft\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # load mdc_2015_dem_10ft as dependency (see mdc_2015_dem_10ft for details).\n  \n  # resample raster with:\n  gdalwarp -tr 100 100 /data/mdc_2015_dem_10ft/download/dem_10ft/w001000.adf download/mdc_2015_dem_100ft.tif\n  \n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 2236 -d -C -I -t 48x48 mdc_2015_dem_100ft.tif -F mdc_2015_dem_100ft > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # create color raster\n  mkdir -p /tiles/raster/mdc_2015_dem_100ft\n  mkdir -p /data/mdc_2015_dem_100ft/derived\n  cd /data/mdc_2015_dem_100ft\n  cat > /data/mdc_2015_dem_100ft/derived/mdc_2015_dem_100ft_color_ramp.txt <<_EOF\n  nv 0 0 0 0\n  22.324 255 255 255 255\n  18.136 219 178 142 255\n  14.318 208 179 124 255\n  10.501 219 200 161 255\n  6.684 250 247 187 255\n  2.867 210 231 171 255\n  -0.30 221 226 183 255\n  -0.91 159 207 251 255\n  _EOF\n  gdaldem color-relief download/mdc_2015_dem_100ft.tif /data/mdc_2015_dem_100ft/derived/mdc_2015_dem_100ft_color_ramp.txt /data/mdc_2015_dem_100ft/derived/mdc_2015_dem_100ft_color.tif -alpha\n  # create color raster and render raster tiles \n  mkdir -p /data/mdc_2015_dem_100ft/derived\n  mkdir -p /tiles/raster/mdc_2015_dem_100ft\n  cd /data/mdc_2015_dem_100ft\n  echo \"\" | base64 -d > /data/mdc_2015_dem_100ft/derived/mdc_2015_dem_100ft_legend.png\n  cp /data/mdc_2015_dem_100ft/derived/mdc_2015_dem_100ft_legend.png /tiles/raster/mdc_2015_dem_100ft/\n  # render raster tiles \n  cd /data/mdc_2015_dem_100ft/\n  gdal2tiles.py -ex --xyz -z 8-14 /data/mdc_2015_dem_100ft/derived/mdc_2015_dem_100ft_color.tif /tiles/raster/mdc_2015_dem_100ft\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_2015_dem_100ft/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_2015_dem_100ft/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-yeum0jp5kyd7z8et -t mdc_2015_dem_100ft > derived/mdc_2015_dem_100ft.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_2015_dem_100ft.sql.tar.gz\n  tar -czf derived/mdc_2015_dem_100ft.sql.tar.gz meta_dcat_mdc_2015_dem_100ft.json -C derived mdc_2015_dem_100ft.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
