    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_distance_to_water",
      "name": "Miami-Dade County Distance to Water",
      "description": "A raster of the euclidean distance from bodies of water within Miami-Dade County.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "510M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_distance_to_water"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "129"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "person"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2021_hylo/download -p /data/mdc_2021_hylo/mdc_distance_to_water/etl\n  chmod 777 /data/mdc_2021_hylo/download\n  cd /data/mdc_2021_hylo\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_2021_hylo.zip 'https://scholarship.miami.edu/view/fileRedirect?instCode=01UOML_INST&filePid=13395678880002976&download=true'\n  \n  # unzip to download directory if update flag is set\n  if do_update == 1 then\n  unzip -d download download/mdc_2021_hylo.zip && rm download/mdc_2021_hylo.zip\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 3857 -d -C -I -t 48x48 GeoTIFF_Rasters/Water_Euclid_Dist_30m_MDC.tif -F mdc_distance_to_water > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # create color raster\n  mkdir -p /tiles/raster/mdc_distance_to_water\n  mkdir -p /data/mdc_2021_hylo/mdc_distance_to_water/derived\n  cd /data/mdc_2021_hylo\n  cat > /data/mdc_2021_hylo/mdc_distance_to_water/derived/mdc_distance_to_water_color_ramp.txt <<_EOF\n  0 171 198 230 255\n  150 171 198 230 230\n  330 171 198 230 199\n  525 171 198 230 166\n  720 171 198 230 133\n  915 171 198 230 99\n  1110 171 198 230 66\n  1305 171 198 230 33\n  1500 171 198 230 0\n  _EOF\n  gdaldem color-relief download/GeoTIFF_Rasters/Water_Euclid_Dist_30m_MDC.tif /data/mdc_2021_hylo/mdc_distance_to_water/derived/mdc_distance_to_water_color_ramp.txt /data/mdc_2021_hylo/mdc_distance_to_water/derived/mdc_distance_to_water_color.tif -alpha\n  # create color raster and render raster tiles \n  mkdir -p /data/mdc_2021_hylo/mdc_distance_to_water/derived\n  mkdir -p /tiles/raster/mdc_distance_to_water\n  cd /data/mdc_2021_hylo\n  echo \"\" | base64 -d > /data/mdc_2021_hylo/mdc_distance_to_water/derived/mdc_distance_to_water_legend.png\n  cp /data/mdc_2021_hylo/mdc_distance_to_water/derived/mdc_distance_to_water_legend.png /tiles/raster/mdc_distance_to_water/\n  # render raster tiles \n  cd /data/mdc_2021_hylo/mdc_distance_to_water/\n  gdal2tiles.py -ex --xyz -z 8-16 /data/mdc_2021_hylo/mdc_distance_to_water/derived/mdc_distance_to_water_color.tif /tiles/raster/mdc_distance_to_water"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "analytic_function",
          "value": "gdsc_zonal_statistics"
        },
        {
          "@type": "PropertyValue",
          "name": "Spatial Reference System",
          "value": "http://www.opengis.net/def/crs/EPSG/0/2236"
        },
        {
          "@type": "PropertyValue",
          "name": "download_method",
          "value": "wget"
        },
        {
          "@type": "PropertyValue",
          "name": "source_file",
          "value": "{'etl_group/file_name_group/file_inside_archive': 'GeoTIFF_Rasters/Water_Euclid_Dist_30m_MDC', 'etl_group/file_name_group/file_name_value': 'mdc_2021_hylo'}"
        },
        {
