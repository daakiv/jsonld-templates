        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "206"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_distritos_minam/download -p /data/hh_distritos_minam/etl\n  chmod 777 /data/hh_distritos_minam/download\n  cd /data/hh_distritos_minam\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_distritos_minam download/hh_distritos_minam.json 'https://geoservidorperu.minam.gob.pe/arcgis/rest/services/ServicioBase/MapServer/12/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&where=1%3D1&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_distritos_minam.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_distritos_minam.json -nlt multipolygon -nln hh_distritos_minam\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_distritos_minam\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_distritos_minam',\n    'geom_local', 5387, 'multipolygon', 2\n  );\n  UPDATE hh_distritos_minam\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_distritos_minam_geom_local_idx\n    ON hh_distritos_minam\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_distritos_minam/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_distritos_minam.shp PG:\"<postgres connection>\" hh_distritos_minam\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_distritos_minam.shp.tar.gz\n  tar -czf derived/hh_distritos_minam.shp.tar.gz meta_dcat_hh_distritos_minam.json -C derived hh_distritos_minam.shp hh_distritos_minam.prj hh_distritos_minam.shx hh_distritos_minam.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_distritos_minam.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_distritos_minam.gpkg PG:\"<postgres connection>\" -select \"objectid_1,objectid,iddist,iddpto,idprov,nombdist,nombprov,nombdep,dcto,ley,fecha,nom_cap,shape_leng,shape_le_1,shape_ar_1,area_minam,geom\" hh_distritos_minam\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_distritos_minam.gpkg.tar.gz\n  tar -czf derived/hh_distritos_minam.gpkg.tar.gz meta_dcat_hh_distritos_minam.json -C derived hh_distritos_minam.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_distritos_minam.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_distritos_minam.json PG:\"<postgres connection>\" -select \"objectid_1,objectid,iddist,iddpto,idprov,nombdist,nombprov,nombdep,dcto,ley,fecha,nom_cap,shape_leng,shape_le_1,shape_ar_1,area_minam,geom\" hh_distritos_minam\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_distritos_minam.geojson.tar.gz\n  tar -czf derived/hh_distritos_minam.geojson.tar.gz meta_dcat_hh_distritos_minam.json -C derived hh_distritos_minam.json\n  \n  # Move into correct directory\n  cd /data/hh_distritos_minam/"
