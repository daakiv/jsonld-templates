        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_unincorporated_zone_desc/download -p /data/mdc_unincorporated_zone_desc/etl\n  chmod 777 /data/mdc_unincorporated_zone_desc/download\n  cd /data/mdc_unincorporated_zone_desc\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_unincorporated_zone_desc.json 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/ArcGIS/rest/services/TBLUnincorporatedZoneDistrict/FeatureServer/0/query?where=1%3D1&outFields=*&f=json'\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_unincorporated_zone_desc.json -nln mdc_unincorporated_zone_desc"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "zone"
        },
        {
          "@type": "PropertyValue",
          "name": "download_method",
          "value": "wget"
        },
        {
