  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_glaciares_ana",
      "name": "Glaciares Huayhuash (ANA)",
      "description": "En la actualidad, la Unidad de Glaciología y Recursos Hídricos de la Dirección de Conservación y Planeamiento de Recursos Hídricos de la Autoridad Nacional del Agua, se encarga de la evaluación, monitoreo y cuantificación del comportamiento de los glaciares y lagunas altoandinas de las cordilleras nevadas del país, con la finalidad de conocer la evolución de los glaciares con relación al cambio climático y la prevención ante los riesgos de los desastres naturales.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "3.2M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_glaciares_ana"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "191"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_glaciares_ana/download -p /data/hh_glaciares_ana/etl\n  chmod 777 /data/hh_glaciares_ana/download\n  cd /data/hh_glaciares_ana\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_glaciares_ana download/hh_glaciares_ana.json 'https://geosnirh.ana.gob.pe/server/rest/services/P%C3%BAblico/Glaciares/MapServer/39/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_glaciares_ana.json -nlt multipolygon -nln hh_glaciares_ana\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_glaciares_ana\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_glaciares_ana',\n    'geom_local', 5387, 'multipolygon', 2\n  );\n  UPDATE hh_glaciares_ana\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_glaciares_ana_geom_local_idx\n    ON hh_glaciares_ana\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_glaciares_ana/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_glaciares_ana.shp PG:\"<postgres connection>\" hh_glaciares_ana\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_glaciares_ana.shp.tar.gz\n  tar -czf derived/hh_glaciares_ana.shp.tar.gz meta_dcat_hh_glaciares_ana.json -C derived hh_glaciares_ana.shp hh_glaciares_ana.prj hh_glaciares_ana.shx hh_glaciares_ana.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_glaciares_ana.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_glaciares_ana.gpkg PG:\"<postgres connection>\" -select \"id,nombre,area_km2,cordillera,fecha_ims,cod_uh1,cod_uh2,ident,cod_uh3,a_gla_uh1,a_gla_uh2,a_gla_uh3,nombre_uh1,cod_glac,geom\" hh_glaciares_ana\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_glaciares_ana.gpkg.tar.gz\n  tar -czf derived/hh_glaciares_ana.gpkg.tar.gz meta_dcat_hh_glaciares_ana.json -C derived hh_glaciares_ana.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_glaciares_ana.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_glaciares_ana.json PG:\"<postgres connection>\" -select \"id,nombre,area_km2,cordillera,fecha_ims,cod_uh1,cod_uh2,ident,cod_uh3,a_gla_uh1,a_gla_uh2,a_gla_uh3,nombre_uh1,cod_glac,geom\" hh_glaciares_ana\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_glaciares_ana.geojson.tar.gz\n  tar -czf derived/hh_glaciares_ana.geojson.tar.gz meta_dcat_hh_glaciares_ana.json -C derived hh_glaciares_ana.json\n  \n  # Move into correct directory\n  cd /data/hh_glaciares_ana/"
        },
