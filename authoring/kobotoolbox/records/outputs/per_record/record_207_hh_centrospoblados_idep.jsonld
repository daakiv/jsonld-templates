    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_centrospoblados_idep",
      "name": "Centros Poblados Huayhuash (IDEP)",
      "description": "Centros Poblados de Huayuhash",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "1.9M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_centrospoblados_idep"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "207"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_centrospoblados_idep/download -p /data/hh_centrospoblados_idep/etl\n  chmod 777 /data/hh_centrospoblados_idep/download\n  cd /data/hh_centrospoblados_idep\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_centrospoblados_idep download/hh_centrospoblados_idep.json 'https://www.idep.gob.pe/geoportal/rest/services/DATOS_GEOESPACIALES/CENTROS_POBLADOS/FeatureServer/3/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&where=1%3D1&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_centrospoblados_idep.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_centrospoblados_idep.json -nlt point -nln hh_centrospoblados_idep\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_centrospoblados_idep\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_centrospoblados_idep',\n    'geom_local', 5387, 'point', 2\n  );\n  UPDATE hh_centrospoblados_idep\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,5387)));\n  CREATE INDEX hh_centrospoblados_idep_geom_local_idx\n    ON hh_centrospoblados_idep\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_centrospoblados_idep/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_centrospoblados_idep.shp PG:\"<postgres connection>\" hh_centrospoblados_idep\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_centrospoblados_idep.shp.tar.gz\n  tar -czf derived/hh_centrospoblados_idep.shp.tar.gz meta_dcat_hh_centrospoblados_idep.json -C derived hh_centrospoblados_idep.shp hh_centrospoblados_idep.prj hh_centrospoblados_idep.shx hh_centrospoblados_idep.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_centrospoblados_idep.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_centrospoblados_idep.gpkg PG:\"<postgres connection>\" -select \"nom_poblad,fuente,código,cat_poblad,dist,prov,dep,cód_int,categoria,x,y,n_busqda,geom\" hh_centrospoblados_idep\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_centrospoblados_idep.gpkg.tar.gz\n  tar -czf derived/hh_centrospoblados_idep.gpkg.tar.gz meta_dcat_hh_centrospoblados_idep.json -C derived hh_centrospoblados_idep.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_centrospoblados_idep.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_centrospoblados_idep.json PG:\"<postgres connection>\" -select \"nom_poblad,fuente,código,cat_poblad,dist,prov,dep,cód_int,categoria,x,y,n_busqda,geom\" hh_centrospoblados_idep\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_centrospoblados_idep.geojson.tar.gz\n  tar -czf derived/hh_centrospoblados_idep.geojson.tar.gz meta_dcat_hh_centrospoblados_idep.json -C derived hh_centrospoblados_idep.json\n  \n  # Move into correct directory\n  cd /data/hh_centrospoblados_idep/"
        },
