      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_catastrominero_ingemmet",
      "name": "Catastro Minero Huayhuash (INGEMMET)",
      "description": "Un catastro minero digital se puede definir como un inventario de áreas mineras que cuenta con respaldos en forma gráfica y alfanumérica en una base de datos digital.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "1.2M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_catastrominero_ingemmet"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "174"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_catastrominero_ingemmet/download -p /data/hh_catastrominero_ingemmet/etl\n  chmod 777 /data/hh_catastrominero_ingemmet/download\n  cd /data/hh_catastrominero_ingemmet\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_catastrominero_ingemmet download/hh_catastrominero_ingemmet.json 'https://geocatmin.ingemmet.gob.pe/arcgis/rest/services/SERV_CATASTRO_MINERO_WGS84/MapServer/0/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_catastrominero_ingemmet.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_catastrominero_ingemmet.json -nlt multipolygon -nln hh_catastrominero_ingemmet\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_catastrominero_ingemmet\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_catastrominero_ingemmet',\n    'geom_local', 5387, 'multipolygon', 2\n  );\n  UPDATE hh_catastrominero_ingemmet\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_catastrominero_ingemmet_geom_local_idx\n    ON hh_catastrominero_ingemmet\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_catastrominero_ingemmet/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_catastrominero_ingemmet.shp PG:\"<postgres connection>\" hh_catastrominero_ingemmet\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_catastrominero_ingemmet.shp.tar.gz\n  tar -czf derived/hh_catastrominero_ingemmet.shp.tar.gz meta_dcat_hh_catastrominero_ingemmet.json -C derived hh_catastrominero_ingemmet.shp hh_catastrominero_ingemmet.prj hh_catastrominero_ingemmet.shx hh_catastrominero_ingemmet.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_catastrominero_ingemmet.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_catastrominero_ingemmet.gpkg PG:\"<postgres connection>\" -select \"objectid,codigou,fec_denu,concesion,tit_conces,hectagis,estado,d_estado,hor_denu,carta,zona,demagis,observ,leyenda,estado_minem,resol_exti,fecha_resol_exti,desic_resol_ext,ubica_exp,califica,sustancia,depa,provi,distri,direccion,hasdatum,fecha_actualizacion,geom\" hh_catastrominero_ingemmet\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_catastrominero_ingemmet.gpkg.tar.gz\n  tar -czf derived/hh_catastrominero_ingemmet.gpkg.tar.gz meta_dcat_hh_catastrominero_ingemmet.json -C derived hh_catastrominero_ingemmet.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_catastrominero_ingemmet.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_catastrominero_ingemmet.json PG:\"<postgres connection>\" -select \"objectid,codigou,fec_denu,concesion,tit_conces,hectagis,estado,d_estado,hor_denu,carta,zona,demagis,observ,leyenda,estado_minem,resol_exti,fecha_resol_exti,desic_resol_ext,ubica_exp,califica,sustancia,depa,provi,distri,direccion,hasdatum,fecha_actualizacion,geom\" hh_catastrominero_ingemmet\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_catastrominero_ingemmet.geojson.tar.gz\n  tar -czf derived/hh_catastrominero_ingemmet.geojson.tar.gz meta_dcat_hh_catastrominero_ingemmet.json -C derived hh_catastrominero_ingemmet.json\n  \n  # Move into correct directory\n  cd /data/hh_catastrominero_ingemmet/"
        },
