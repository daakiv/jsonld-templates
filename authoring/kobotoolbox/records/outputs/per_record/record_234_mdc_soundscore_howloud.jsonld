        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "234"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_soundscore_howloud/download -p /data/mdc_soundscore_howloud/etl\n  chmod 777 /data/mdc_soundscore_howloud/download\n  cd /data/mdc_soundscore_howloud\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
