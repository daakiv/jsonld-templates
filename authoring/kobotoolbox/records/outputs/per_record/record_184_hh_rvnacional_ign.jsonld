  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_rvnacional_ign",
      "name": "Red Vial Nacional Huayhuash (IGN)",
      "description": "Los datos corresponden a las carreteras de interés nacional; conformada por los principales ejes longitudinales y transversales, que constituyen la base del Sistema Nacional de Carreteras (SINAC); carreteras que sirven como elemento receptor de las carreteras Departamentales o Regionales y de las carreteras Vecinales o Rurales.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "279K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_rvnacional_ign"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "184"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_rvnacional_ign/download -p /data/hh_rvnacional_ign/etl\n  chmod 777 /data/hh_rvnacional_ign/download\n  cd /data/hh_rvnacional_ign\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_rvnacional_ign download/hh_rvnacional_ign.json 'https://geoservidorperu.minam.gob.pe/arcgis/rest/services/Servicio_Degradacion_tematicas/MapServer/1/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_rvnacional_ign.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_rvnacional_ign.json -nlt multilinestring -nln hh_rvnacional_ign\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_rvnacional_ign\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_rvnacional_ign',\n    'geom_local', 5387, 'multilinestring', 2\n  );\n  UPDATE hh_rvnacional_ign\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_rvnacional_ign_geom_local_idx\n    ON hh_rvnacional_ign\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_rvnacional_ign/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_rvnacional_ign.shp PG:\"<postgres connection>\" hh_rvnacional_ign\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_rvnacional_ign.shp.tar.gz\n  tar -czf derived/hh_rvnacional_ign.shp.tar.gz meta_dcat_hh_rvnacional_ign.json -C derived hh_rvnacional_ign.shp hh_rvnacional_ign.prj hh_rvnacional_ign.shx hh_rvnacional_ign.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_rvnacional_ign.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_rvnacional_ign.gpkg PG:\"<postgres connection>\" -select \"objectid,dpto,ruta_d044,red_044,longkm_d44,super_rod,shape_stlength__,geom\" hh_rvnacional_ign\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_rvnacional_ign.gpkg.tar.gz\n  tar -czf derived/hh_rvnacional_ign.gpkg.tar.gz meta_dcat_hh_rvnacional_ign.json -C derived hh_rvnacional_ign.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_rvnacional_ign.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_rvnacional_ign.json PG:\"<postgres connection>\" -select \"objectid,dpto,ruta_d044,red_044,longkm_d44,super_rod,shape_stlength__,geom\" hh_rvnacional_ign\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_rvnacional_ign.geojson.tar.gz\n  tar -czf derived/hh_rvnacional_ign.geojson.tar.gz meta_dcat_hh_rvnacional_ign.json -C derived hh_rvnacional_ign.json\n  \n  # Move into correct directory\n  cd /data/hh_rvnacional_ign/"
        },
