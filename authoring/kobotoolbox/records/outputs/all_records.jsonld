          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "200"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2017_viirs_vnp46a4/download -p /data/mdc_2017_viirs_vnp46a4/etl\n  chmod 777 /data/mdc_2017_viirs_vnp46a4/download\n  cd /data/mdc_2017_viirs_vnp46a4\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # load egom_2017_viirs_vnp46a4 as dependency (see egom_2017_viirs_vnp46a4 for details).\n  \n  # load fl_2022_tl_cousub as dependency (see fl_2022_tl_cousub for details).\n  \n  # clip raster with geometry as:\n    gdalwarp -cutline PG:\"<postgres connection>\" -csql \"SELECT geom FROM fl_2022_tl_cousub WHERE countyfp='086'\" -crop_to_cutline -s_srs EPSG:4326 -t_srs EPSG:4326 -srcnodata 65535 -dstnodata 65535 /data/egom_2017_viirs_vnp46a4/download/VNP46A4.A2017001.h09v06.002.2025105122545.h5.tif download/VNP46A4.A2017001.h09v06.002.2025105122545.tif\n   \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 4326 -d -C -I -t auto VNP46A4.A2017001.h09v06.002.2025105122545.tif -F mdc_2017_viirs_vnp46a4 > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # create color raster\n  mkdir -p /tiles/raster/mdc_2017_viirs_vnp46a4\n  mkdir -p /data/mdc_2017_viirs_vnp46a4/derived\n  cd /data/mdc_2017_viirs_vnp46a4\n  cat > /data/mdc_2017_viirs_vnp46a4/derived/mdc_2017_viirs_vnp46a4_color_ramp.txt <<_EOF\n  nv 0 0 0 0\n  1500 252 255 164 255\n  1333 247 208 60 255\n  1166 251 154 7 255\n  1000 237 105 37 255\n  833 206 68 70 255\n  666 165 45 96 255\n  500 120 28 109 255\n  333 76 12 107 255\n  166 27 12 65 255\n  0 0 0 4 255\n  _EOF\n  gdaldem color-relief download/VNP46A4.A2017001.h09v06.002.2025105122545.tif /data/mdc_2017_viirs_vnp46a4/derived/mdc_2017_viirs_vnp46a4_color_ramp.txt /data/mdc_2017_viirs_vnp46a4/derived/mdc_2017_viirs_vnp46a4_color.tif -alpha\n  # create color raster and render raster tiles \n  mkdir -p /data/mdc_2017_viirs_vnp46a4/derived\n  mkdir -p /tiles/raster/mdc_2017_viirs_vnp46a4\n  cd /data/mdc_2017_viirs_vnp46a4\n  echo \"\" | base64 -d > /data/mdc_2017_viirs_vnp46a4/derived/mdc_2017_viirs_vnp46a4_legend.png\n  cp /data/mdc_2017_viirs_vnp46a4/derived/mdc_2017_viirs_vnp46a4_legend.png /tiles/raster/mdc_2017_viirs_vnp46a4/\n  # render raster tiles \n  cd /data/mdc_2017_viirs_vnp46a4/\n  gdal2tiles.py -ex --xyz -z 8-12 /data/mdc_2017_viirs_vnp46a4/derived/mdc_2017_viirs_vnp46a4_color.tif /tiles/raster/mdc_2017_viirs_vnp46a4"
        },
