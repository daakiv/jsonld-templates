      "name": "Miami-Dade County Unincorporated Zone District Specifications",
      "description": "A table that provides a description of the main development attributes for each Zoning District in Unincorporated Miami Dade County.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "12K"
