    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_2021_surface_temperature_30m",
      "name": "Miami-Dade Surface Temperature (degrees Fahrenheit)",
      "description": "Max Landsat 8 ARD (Analysis Ready Data) Surface Temperature from 7 different images ranging from 2011-2020.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "510M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_2021_surface_temperature_30m"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "14"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "person"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2021_hylo/download -p /data/mdc_2021_hylo/mdc_2021_surface_temperature_30m/etl\n  chmod 777 /data/mdc_2021_hylo/download\n  cd /data/mdc_2021_hylo\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_2021_hylo.zip 'https://scholarship.miami.edu/view/fileRedirect?instCode=01UOML_INST&filePid=13395678880002976&download=true'\n  \n  # unzip to download directory if update flag is set\n  if do_update == 1 then\n  unzip -d download download/mdc_2021_hylo.zip && rm download/mdc_2021_hylo.zip\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 3857 -d -C -I -t 48x48 GeoTIFF_Rasters/Surface_Temperature_30m.tif -F mdc_2021_surface_temperature_30m > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_2021_hylo/mdc_2021_surface_temperature_30m/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_2021_hylo/mdc_2021_surface_temperature_30m/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-72ig7aqxzmrbe54h -t mdc_2021_surface_temperature_30m > derived/mdc_2021_surface_temperature_30m.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_2021_surface_temperature_30m.sql.tar.gz\n  tar -czf derived/mdc_2021_surface_temperature_30m.sql.tar.gz meta_dcat_mdc_2021_surface_temperature_30m.json -C derived mdc_2021_surface_temperature_30m.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "analytic_function",
          "value": "gdsc_zonal_statistics"
        },
        {
