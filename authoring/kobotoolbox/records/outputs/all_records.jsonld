COMMENT ON COLUMN mdc_2021_acs_5yr_tract_dvmt.number_of_housing_structures_with_20_49_units IS 'b25024_008e';\n  DROP TABLE number_of_housing_structures_with_20_49_units;\n  \n  -- join number_of_housing_structures_with_50_or_more_units to mdc_2021_acs_5yr_tract_dvmt\n  ALTER TABLE mdc_2021_acs_5yr_tract_dvmt ADD COLUMN number_of_housing_structures_with_50_or_more_units integer;\n  UPDATE mdc_2021_acs_5yr_tract_dvmt\n    SET number_of_housing_structures_with_50_or_more_units = st.agg\n    FROM (SELECT geoid, (b25024_009e::integer) AS agg FROM number_of_housing_structures_with_50_or_more_units) st\n    WHERE mdc_2021_acs_5yr_tract_dvmt.geoid = st.geoid;\n  COMMENT ON COLUMN mdc_2021_acs_5yr_tract_dvmt.number_of_housing_structures_with_50_or_more_units IS 'b25024_009e';\n  DROP TABLE number_of_housing_structures_with_50_or_more_units;\n  \n  -- join housing_tenancy__owner_occupied_housing_units to mdc_2021_acs_5yr_tract_dvmt\n  ALTER TABLE mdc_2021_acs_5yr_tract_dvmt ADD COLUMN housing_tenancy__owner_occupied_housing_units integer;\n  UPDATE mdc_2021_acs_5yr_tract_dvmt\n    SET housing_tenancy__owner_occupied_housing_units = st.agg\n    FROM (SELECT geoid, (b25003_002e::integer) AS agg FROM housing_tenancy__owner_occupied_housing_units) st\n    WHERE mdc_2021_acs_5yr_tract_dvmt.geoid = st.geoid;\n  COMMENT ON COLUMN mdc_2021_acs_5yr_tract_dvmt.housing_tenancy__owner_occupied_housing_units IS 'b25003_002e';\n  DROP TABLE housing_tenancy__owner_occupied_housing_units;\n  \n  -- join housing_tenancy__renter_occupied_housing_units to mdc_2021_acs_5yr_tract_dvmt\n  ALTER TABLE mdc_2021_acs_5yr_tract_dvmt ADD COLUMN housing_tenancy__renter_occupied_housing_units integer;\n  UPDATE mdc_2021_acs_5yr_tract_dvmt\n    SET housing_tenancy__renter_occupied_housing_units = st.agg\n    FROM (SELECT geoid, (b25003_003e::integer) AS agg FROM housing_tenancy__renter_occupied_housing_units) st\n    WHERE mdc_2021_acs_5yr_tract_dvmt.geoid = st.geoid;\n  COMMENT ON COLUMN mdc_2021_acs_5yr_tract_dvmt.housing_tenancy__renter_occupied_housing_units IS 'b25003_003e';\n  DROP TABLE housing_tenancy__renter_occupied_housing_units;\n  \n  DELETE FROM mdc_2021_acs_5yr_tract_dvmt WHERE total_population is Null;\n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_2021_acs_5yr_tract_dvmt',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_2021_acs_5yr_tract_dvmt\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_2021_acs_5yr_tract_dvmt_geom_local_idx\n    ON mdc_2021_acs_5yr_tract_dvmt\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_2021_acs_5yr_tract_dvmt/\n  mkdir -p derived\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/mdc_2021_acs_5yr_tract_dvmt.json\n  ogr2ogr -f GeoJSON -overwrite derived/mdc_2021_acs_5yr_tract_dvmt.json PG:\"<postgres connection>\" -select \"total_population,persons_4_years_old_and_younger,age_of_5_and_19,persons_between_the_age_of_20_and_64,persons_65_years_old_and_over,white_alone,black_or_african_american_alone,american_indian_and_alaska_native_alone,asian_alone,pacific_islander,some_other_race,two_or_more_races,hispanic_or_latino__any_race,white_alone__not_hispanic_or_latino,high_school_degree__ged_or_lower,some_college__no_degree,associates_degree,bachelors_degree,graduate_professional_degree,median_income_of_residents,median_monthly_housing_costs,median_monthly_owner_costs,median_monthly_renter_costs,median_monthly_owner_costs__percent_household_income,median_monthly_renter_costs__percent_household_income,aggregate_household_income,households_below_poverty_level,medicare_recipients,total_medicaid_recipients,total_snap_recipients,armed_forces_veterans,total_number_of_disabled_residents,total_housing_units,total_single_family_houses,total_duplex_multiple_units__less_than_10_units,number_of_housing_structures_with_10_19_units,number_of_housing_structures_with_20_49_units,number_of_housing_structures_with_50_or_more_units,housing_tenancy__owner_occupied_housing_units,housing_tenancy__renter_occupied_housing_units,geom\" mdc_2021_acs_5yr_tract_dvmt\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/mdc_2021_acs_5yr_tract_dvmt.geojson.tar.gz\n  tar -czf derived/mdc_2021_acs_5yr_tract_dvmt.geojson.tar.gz meta_dcat_mdc_2021_acs_5yr_tract_dvmt.json -C derived mdc_2021_acs_5yr_tract_dvmt.json\n  \n  # Move into correct directory\n  cd /data/mdc_2021_acs_5yr_tract_dvmt/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-khnik2m9ykzssn5w -t mdc_2021_acs_5yr_tract_dvmt > derived/mdc_2021_acs_5yr_tract_dvmt.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_2021_acs_5yr_tract_dvmt.sql.tar.gz\n  tar -czf derived/mdc_2021_acs_5yr_tract_dvmt.sql.tar.gz meta_dcat_mdc_2021_acs_5yr_tract_dvmt.json -C derived mdc_2021_acs_5yr_tract_dvmt.sql"
