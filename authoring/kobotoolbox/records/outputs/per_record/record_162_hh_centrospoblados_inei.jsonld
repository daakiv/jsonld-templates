  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_centrospoblados_inei",
      "name": "Centros Poblados Huayhuash (INEI)",
      "description": "Centros Poblados de Huayuhash",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "1.4M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_centrospoblados_inei"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "162"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_centrospoblados_inei/download -p /data/hh_centrospoblados_inei/etl\n  chmod 777 /data/hh_centrospoblados_inei/download\n  cd /data/hh_centrospoblados_inei\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  curl -k -o download/hh_centrospoblados_inei.json 'https://maps.inei.gob.pe/T10Limites/ows?service=WFS&version=2.0.0&request=GetFeature&typeName=T10Limites:ig_cpoblado&OUTPUTFORMAT=application/json&bbox=-77.33,-10.7,-76.55,-9.8,EPSG:4326'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_centrospoblados_inei.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_centrospoblados_inei.json -nlt point -nln hh_centrospoblados_inei\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_centrospoblados_inei\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_centrospoblados_inei',\n    'geom_local', 5387, 'point', 2\n  );\n  UPDATE hh_centrospoblados_inei\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,5387)));\n  CREATE INDEX hh_centrospoblados_inei_geom_local_idx\n    ON hh_centrospoblados_inei\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_centrospoblados_inei/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_centrospoblados_inei.shp PG:\"<postgres connection>\" hh_centrospoblados_inei\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_centrospoblados_inei.shp.tar.gz\n  tar -czf derived/hh_centrospoblados_inei.shp.tar.gz meta_dcat_hh_centrospoblados_inei.json -C derived hh_centrospoblados_inei.shp hh_centrospoblados_inei.prj hh_centrospoblados_inei.shx hh_centrospoblados_inei.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_centrospoblados_inei.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_centrospoblados_inei.gpkg PG:\"<postgres connection>\" -select \"objectid,shape,ubigeo,codccpp,latitud,longitud,altitud,poblacion,idccpp,nombccpp,area,nombdep,nombprov,nombdist,totalviv,codvraem,nomdist,nomprov,nomdep,ceco_1001,ceco_1002,ceco_1301,viv_1002,viv_1004,viv_1012,viv_1018,viv_1302,viv_1304,geom\" hh_centrospoblados_inei\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_centrospoblados_inei.gpkg.tar.gz\n  tar -czf derived/hh_centrospoblados_inei.gpkg.tar.gz meta_dcat_hh_centrospoblados_inei.json -C derived hh_centrospoblados_inei.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_centrospoblados_inei.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_centrospoblados_inei.json PG:\"<postgres connection>\" -select \"objectid,shape,ubigeo,codccpp,latitud,longitud,altitud,poblacion,idccpp,nombccpp,area,nombdep,nombprov,nombdist,totalviv,codvraem,nomdist,nomprov,nomdep,ceco_1001,ceco_1002,ceco_1301,viv_1002,viv_1004,viv_1012,viv_1018,viv_1302,viv_1304,geom\" hh_centrospoblados_inei\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_centrospoblados_inei.geojson.tar.gz\n  tar -czf derived/hh_centrospoblados_inei.geojson.tar.gz meta_dcat_hh_centrospoblados_inei.json -C derived hh_centrospoblados_inei.json\n  \n  # Move into correct directory\n  cd /data/hh_centrospoblados_inei/"
        },
