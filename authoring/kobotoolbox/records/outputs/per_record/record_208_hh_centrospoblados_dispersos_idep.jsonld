      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_centrospoblados_dispersos_idep",
      "name": "Centros Poblados Huayhuash (IDEP-INEI)",
      "description": "Centros Poblados de Huayuhash",
