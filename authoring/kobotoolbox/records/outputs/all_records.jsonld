    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_property_point_view",
      "name": "Miami-Dade Property Point View",
      "description": "A point feature class of all properties within Miami-Dade County",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "1.1G"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_property_point_view"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "33"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_property_point_view/download -p /data/mdc_property_point_view/etl\n  chmod 777 /data/mdc_property_point_view/download\n  cd /data/mdc_property_point_view\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln mdc_property_point_view download/mdc_property_point_view.geojson 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/PaGISView_gdb/FeatureServer/0/query?where=OBJECTID%3E0&outFields=*&outSR=4326&f=json&orderBy=ObjectId'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_property_point_view.geojson\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_property_point_view.geojson -nlt point -nln mdc_property_point_view\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_property_point_view\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_property_point_view',\n    'geom_local', 2236, 'point', 2\n  );\n  UPDATE mdc_property_point_view\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,2236)));\n  CREATE INDEX mdc_property_point_view_geom_local_idx\n    ON mdc_property_point_view\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_property_point_view/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_property_point_view/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-8023cbmya7hv8n1f -t mdc_property_point_view > derived/mdc_property_point_view.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_property_point_view.sql.tar.gz\n  tar -czf derived/mdc_property_point_view.sql.tar.gz meta_dcat_mdc_property_point_view.json -C derived mdc_property_point_view.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "folio"
        },
        {
          "@type": "PropertyValue",
          "name": "analytic_function",
          "value": "gdsc_nearest_neighbor"
        },
        {
          "@type": "PropertyValue",
          "name": "Spatial Reference System",
          "value": "http://www.opengis.net/def/crs/EPSG/0/2236"
        },
        {
          "@type": "PropertyValue",
          "name": "derivatives",
          "value": "sql"
        },
        {
          "@type": "PropertyValue",
          "name": "download_method",
          "value": "esri_recursive_ogr"
        },
        {
          "@type": "PropertyValue",
          "name": "source_file",
          "value": "{'etl_group/file_name_group/file_name_value': 'mdc_property_point_view'}"
        },
        {
          "@type": "PropertyValue",
          "name": "extent",
          "value": "POLYGON((-80.872664 25.145869, -80.118765 25.145869, -80.118765 25.975006, -80.872664 25.975006, -80.872664 25.145869))"
        },
        {
          "@type": "PropertyValue",
          "name": "podid",
          "value": "gdsc-postgis-node-8023cbmya7hv8n1f"
