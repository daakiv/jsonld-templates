    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_lagunas_ana",
      "name": "Lagos y Lagunas Huayhuash (ANA)",
      "description": "Lagos y Lagunas de Huayhuash.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "3.1M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_lagunas_ana"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "157"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_lagunas_ana/download -p /data/hh_lagunas_ana/etl\n  chmod 777 /data/hh_lagunas_ana/download\n  cd /data/hh_lagunas_ana\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_lagunas_ana download/hh_lagunas_ana.json 'https://geosnirh.ana.gob.pe/server/rest/services/P%C3%BAblico/Lagunas/MapServer/36/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_lagunas_ana.json -nlt multipolygon -nln hh_lagunas_ana\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_lagunas_ana\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_lagunas_ana',\n    'geom_local', 5387, 'multipolygon', 2\n  );\n  UPDATE hh_lagunas_ana\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_lagunas_ana_geom_local_idx\n    ON hh_lagunas_ana\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_lagunas_ana/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_lagunas_ana.shp PG:\"<postgres connection>\" hh_lagunas_ana\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_lagunas_ana.shp.tar.gz\n  tar -czf derived/hh_lagunas_ana.shp.tar.gz meta_dcat_hh_lagunas_ana.json -C derived hh_lagunas_ana.shp hh_lagunas_ana.prj hh_lagunas_ana.shx hh_lagunas_ana.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_lagunas_ana.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_lagunas_ana.gpkg PG:\"<postgres connection>\" -select \"id,nombreoficial,ubigeo,nombrecuerpo,codala,ala,codaaa,aaa,coordillera,fechaimagensatelital,fuente,geom,codigouh,nombreuh,geom\" hh_lagunas_ana\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_lagunas_ana.gpkg.tar.gz\n  tar -czf derived/hh_lagunas_ana.gpkg.tar.gz meta_dcat_hh_lagunas_ana.json -C derived hh_lagunas_ana.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_lagunas_ana.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_lagunas_ana.json PG:\"<postgres connection>\" -select \"id,nombreoficial,ubigeo,nombrecuerpo,codala,ala,codaaa,aaa,coordillera,fechaimagensatelital,fuente,geom,codigouh,nombreuh,geom\" hh_lagunas_ana\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_lagunas_ana.geojson.tar.gz\n  tar -czf derived/hh_lagunas_ana.geojson.tar.gz meta_dcat_hh_lagunas_ana.json -C derived hh_lagunas_ana.json\n  \n  # Move into correct directory\n  cd /data/hh_lagunas_ana/"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
