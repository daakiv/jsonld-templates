        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_bus_stops/download -p /data/mdc_bus_stops/etl\n  chmod 777 /data/mdc_bus_stops/download\n  cd /data/mdc_bus_stops\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_bus_stops.json 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/BusStops_gdb/FeatureServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=json'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_bus_stops.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_bus_stops.json -nlt point -nln mdc_bus_stops\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_bus_stops\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_bus_stops',\n    'geom_local', 2236, 'point', 2\n  );\n  UPDATE mdc_bus_stops\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,2236)));\n  CREATE INDEX mdc_bus_stops_geom_local_idx\n    ON mdc_bus_stops\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_bus_stops/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_bus_stops/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-ro9z9m3v4bb25mhu -t mdc_bus_stops > derived/mdc_bus_stops.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_bus_stops.sql.tar.gz\n  tar -czf derived/mdc_bus_stops.sql.tar.gz meta_dcat_mdc_bus_stops.json -C derived mdc_bus_stops.sql"
        },
        {
