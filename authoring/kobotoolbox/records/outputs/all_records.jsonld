    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_capitaldistrital_minam",
      "name": "Capital Distrital Huayhuash (MINAM)",
      "description": "Una colecion de puntos geograficos con nombres para los capitales distritales en la Cordillera Huayhuash. Fuente: el Ministerio de Ambiente.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "16K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_capitaldistrital_minam"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "182"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_capitaldistrital_minam/download -p /data/hh_capitaldistrital_minam/etl\n  chmod 777 /data/hh_capitaldistrital_minam/download\n  cd /data/hh_capitaldistrital_minam\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_capitaldistrital_minam download/hh_capitaldistrital_minam.json 'https://www.idep.gob.pe/geoportal/rest/services/DATOS_GEOESPACIALES/CENTROS_POBLADOS/FeatureServer/2/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_capitaldistrital_minam.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_capitaldistrital_minam.json -nlt point -nln hh_capitaldistrital_minam\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_capitaldistrital_minam\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_capitaldistrital_minam',\n    'geom_local', 5387, 'point', 2\n  );\n  UPDATE hh_capitaldistrital_minam\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,5387)));\n  CREATE INDEX hh_capitaldistrital_minam_geom_local_idx\n    ON hh_capitaldistrital_minam\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_capitaldistrital_minam/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_capitaldistrital_minam.shp PG:\"<postgres connection>\" hh_capitaldistrital_minam\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_capitaldistrital_minam.shp.tar.gz\n  tar -czf derived/hh_capitaldistrital_minam.shp.tar.gz meta_dcat_hh_capitaldistrital_minam.json -C derived hh_capitaldistrital_minam.shp hh_capitaldistrital_minam.prj hh_capitaldistrital_minam.shx hh_capitaldistrital_minam.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_capitaldistrital_minam.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_capitaldistrital_minam.gpkg PG:\"<postgres connection>\" -select \"objectid,nom_poblad,fuente,f_code,código,cat_poblad,dist,prov,dep,cód_hoja,cód_int,categoría,x_coord,y_coord,geom\" hh_capitaldistrital_minam\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_capitaldistrital_minam.gpkg.tar.gz\n  tar -czf derived/hh_capitaldistrital_minam.gpkg.tar.gz meta_dcat_hh_capitaldistrital_minam.json -C derived hh_capitaldistrital_minam.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_capitaldistrital_minam.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_capitaldistrital_minam.json PG:\"<postgres connection>\" -select \"objectid,nom_poblad,fuente,f_code,código,cat_poblad,dist,prov,dep,cód_hoja,cód_int,categoría,x_coord,y_coord,geom\" hh_capitaldistrital_minam\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_capitaldistrital_minam.geojson.tar.gz\n  tar -czf derived/hh_capitaldistrital_minam.geojson.tar.gz meta_dcat_hh_capitaldistrital_minam.json -C derived hh_capitaldistrital_minam.json\n  \n  # Move into correct directory\n  cd /data/hh_capitaldistrital_minam/"
