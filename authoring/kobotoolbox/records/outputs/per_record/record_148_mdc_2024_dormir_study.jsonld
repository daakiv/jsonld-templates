      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_2024_dormir_study",
      "name": "Miami-Dade 2025 DORMIR Study",
      "description": "A set of patient home locations in Miami-Dade County joined to the sleep study data collection based on point location",
      "additionalProperty": [
