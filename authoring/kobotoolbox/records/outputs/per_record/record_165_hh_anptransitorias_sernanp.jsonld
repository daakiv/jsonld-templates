  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_anptransitorias_sernanp",
      "name": "Áreas Naturales Protegidas de Administración Nacional Transitoria Huayhuash (SERNANP)",
      "description": "Representa aquellos espacios importantes para la conservación de la diversidad biológica pero que por falta de estudios que sustenten una categoría definitiva, se han establecido con un estatus transitorio, hasta completar los estudios que determinen su nivel de administración y la categoría que le corresponde, estos estatus transitorios son las Zonas Reservadas. ",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "95K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_anptransitorias_sernanp"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "165"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_anptransitorias_sernanp/download -p /data/hh_anptransitorias_sernanp/etl\n  chmod 777 /data/hh_anptransitorias_sernanp/download\n  cd /data/hh_anptransitorias_sernanp\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_anptransitorias_sernanp download/hh_anptransitorias_sernanp.json 'https://geoservicios.sernanp.gob.pe/arcgis/rest/services/base_fisica/peru_sernanp_0102/MapServer/1/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_anptransitorias_sernanp.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_anptransitorias_sernanp.json -nlt multipolygon -nln hh_anptransitorias_sernanp\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_anptransitorias_sernanp\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_anptransitorias_sernanp',\n    'geom_local', 5387, 'multipolygon', 2\n  );\n  UPDATE hh_anptransitorias_sernanp\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_anptransitorias_sernanp_geom_local_idx\n    ON hh_anptransitorias_sernanp\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_anptransitorias_sernanp/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_anptransitorias_sernanp.shp PG:\"<postgres connection>\" hh_anptransitorias_sernanp\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_anptransitorias_sernanp.shp.tar.gz\n  tar -czf derived/hh_anptransitorias_sernanp.shp.tar.gz meta_dcat_hh_anptransitorias_sernanp.json -C derived hh_anptransitorias_sernanp.shp hh_anptransitorias_sernanp.prj hh_anptransitorias_sernanp.shx hh_anptransitorias_sernanp.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_anptransitorias_sernanp.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_anptransitorias_sernanp.gpkg PG:\"<postgres connection>\" -select \"objectid,zr_codi,zr_nomb,anp_sect,zr_ubpo,anp_suleg,zr_balec,zr_felec,zr_balem,zr_felem,shape,met_link,geom\" hh_anptransitorias_sernanp\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_anptransitorias_sernanp.gpkg.tar.gz\n  tar -czf derived/hh_anptransitorias_sernanp.gpkg.tar.gz meta_dcat_hh_anptransitorias_sernanp.json -C derived hh_anptransitorias_sernanp.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_anptransitorias_sernanp.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_anptransitorias_sernanp.json PG:\"<postgres connection>\" -select \"objectid,zr_codi,zr_nomb,anp_sect,zr_ubpo,anp_suleg,zr_balec,zr_felec,zr_balem,zr_felem,shape,met_link,geom\" hh_anptransitorias_sernanp\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_anptransitorias_sernanp.geojson.tar.gz\n  tar -czf derived/hh_anptransitorias_sernanp.geojson.tar.gz meta_dcat_hh_anptransitorias_sernanp.json -C derived hh_anptransitorias_sernanp.json\n  \n  # Move into correct directory\n  cd /data/hh_anptransitorias_sernanp/"
        },
