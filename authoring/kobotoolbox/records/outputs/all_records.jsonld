    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_dem_srtm",
      "name": "Huayhuash DEM (SRTM)",
      "description": "An elevation raster dataset derived from the SRTM GL1 V3 dataset at 1 ARC second resolution (~30 meters). ",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "250M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_dem_srtm"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "188"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_dem_srtm/download -p /data/hh_dem_srtm/etl\n  chmod 777 /data/hh_dem_srtm/download\n  cd /data/hh_dem_srtm\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 4326 -d -C -I -t auto hh_dem_srtm.tif -F hh_dem_srtm > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # render raster tiles \n  cd /data/hh_dem_srtm/\n  gdal2tiles.py -ex --xyz -z 14-18 /data/hh_dem_srtm/download/hh_dem_srtm.tif /tiles/raster/hh_dem_srtm\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_dem_srtm/\n  mkdir -p derived\n  \n  # Create downloadable zip of download/geotiff in derivate directory \n  rm -f derived/hh_dem_srtm.tif.tar.gz\n  tar -czf derived/hh_dem_srtm.tif.tar.gz meta_dcat_hh_dem_srtm.json -C download hh_dem_srtm.tif\n  \n  # Move into correct directory\n  cd /data/hh_dem_srtm/"
        },
