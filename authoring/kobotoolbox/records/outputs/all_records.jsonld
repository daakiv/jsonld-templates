          "value": "feet"
        },
        {
          "@type": "PropertyValue",
          "name": "extent",
          "value": "POLYGON((-80.882526 25.224975, -80.105243 25.224975, -80.105243 26.025565, -80.882526 26.025565, -80.882526 25.224975))"
        },
        {
          "@type": "PropertyValue",
          "name": "podid",
          "value": "gdsc-postgis-node-hlng7lrt3rppxfyy"
        },
        {
          "@type": "PropertyValue",
          "name": "up",
          "value": "true"
        },
        {
          "@type": "PropertyValue",
          "name": "customParameters",
          "value": "mdc_2015_dem_10ft|30"
        },
        {
          "@type": "PropertyValue",
          "name": "colorRamp",
          "value": "nv 0 0 0 0\n  22.324 255 255 255 255\n  18.136 219 178 142 255\n  14.318 208 179 124 255\n  10.501 219 200 161 255\n  6.684 250 247 187 255\n  2.867 210 231 171 255\n  -0.30 221 226 183 255\n  -0.91 159 207 251 255"
        },
        {
          "@type": "PropertyValue",
          "name": "tileBaseUrl",
          "value": "{'cartography_group/tile_url_group/tile_base_url': 'https://gdsc.idsc.miami.edu/rastertiles/mdc_2015_dem_30ft/'}"
        },
