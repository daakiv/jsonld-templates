            "name": "FNAI"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    ma_id",
          "description": "Managed Area ID, designed by NatureServe. Unique identifier for each Managed Area.",
          "qudt:dataType": "xsd:float",
          "unitText": "uniqueid",
          "sourceOrganization": {
            "@type": "Organization",
            "name": "FNAI"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    macode_bcd",
          "description": "Managed Area Code",
          "qudt:dataType": "xsd:string",
          "sourceOrganization": {
            "@type": "Organization",
            "name": "The Nature Conservancy"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    maname",
          "description": "Official name of the Managed Area (conservation land)",
          "qudt:dataType": "xsd:string",
          "sourceOrganization": {
            "@type": "Organization",
            "name": "The managing agency of the Managed Area"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "majorma",
          "description": "Official name of the Major Managed Area. Major Managed Area refers to a larger Managed Area that contains the Managed Area in question.",
          "qudt:dataType": "xsd:string",
          "sourceOrganization": {
            "@type": "Organization",
            "name": "FNAI"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    matype",
          "description": "Code for the Managed Area by lead managing agency. Each Managed Area has been coded as 1st byte = Managing Agency Category: F=Federal, S=State, L=Local, P=Private, 2nd and 3rd bytes = Managing Agency: (e.g., AF= US Air Force), 4th and 5th bytes = Managed Area Unit Type (e.g., AB= Air Force Base)",
          "qudt:dataType": "xsd:string",
          "sourceOrganization": {
            "@type": "Organization",
            "name": "The Nature Conservancy and FNAI"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    managing_a",
