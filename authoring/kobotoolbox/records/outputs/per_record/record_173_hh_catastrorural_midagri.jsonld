  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_catastrorural_midagri",
      "name": "Catastro Rural Huayhuash (MIDAGRI)",
      "description": "Catastro Rural Huayhuash de la sistema MIDAGRI. Hay problemas graves con este base debido a un fluye de infromacion problematico desde las regiones a la oficina nacional. ",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "19M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_catastrorural_midagri"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "173"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_catastrorural_midagri/download -p /data/hh_catastrorural_midagri/etl\n  chmod 777 /data/hh_catastrorural_midagri/download\n  cd /data/hh_catastrorural_midagri\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr --config GDAL_HTTP_UNSAFESSL YES -nln hh_catastrorural_midagri download/hh_catastrorural_midagri.json 'https://georural.midagri.gob.pe/geoservicios/rest/services/public/Catastro_Rural/MapServer/0/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_catastrorural_midagri.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_catastrorural_midagri.json -nlt multipolygon -nln hh_catastrorural_midagri\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_catastrorural_midagri\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_catastrorural_midagri',\n    'geom_local', 5387, 'multipolygon', 2\n  );\n  UPDATE hh_catastrorural_midagri\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_catastrorural_midagri_geom_local_idx\n    ON hh_catastrorural_midagri\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_catastrorural_midagri/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_catastrorural_midagri.shp PG:\"<postgres connection>\" hh_catastrorural_midagri\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_catastrorural_midagri.shp.tar.gz\n  tar -czf derived/hh_catastrorural_midagri.shp.tar.gz meta_dcat_hh_catastrorural_midagri.json -C derived hh_catastrorural_midagri.shp hh_catastrorural_midagri.prj hh_catastrorural_midagri.shx hh_catastrorural_midagri.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_catastrorural_midagri.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_catastrorural_midagri.gpkg PG:\"<postgres connection>\" -select \"objectid,id_dist,cod_predio_sset,observacion,num_predio,cod_predio,hoja,area_ha,perimetro,centroid_e,centroid_n,origen,datum,calculo,id_plano,shape,st_area(shape),st_length(shape),cod_proy,geom\" hh_catastrorural_midagri\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_catastrorural_midagri.gpkg.tar.gz\n  tar -czf derived/hh_catastrorural_midagri.gpkg.tar.gz meta_dcat_hh_catastrorural_midagri.json -C derived hh_catastrorural_midagri.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_catastrorural_midagri.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_catastrorural_midagri.json PG:\"<postgres connection>\" -select \"objectid,id_dist,cod_predio_sset,observacion,num_predio,cod_predio,hoja,area_ha,perimetro,centroid_e,centroid_n,origen,datum,calculo,id_plano,shape,st_area(shape),st_length(shape),cod_proy,geom\" hh_catastrorural_midagri\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_catastrorural_midagri.geojson.tar.gz\n  tar -czf derived/hh_catastrorural_midagri.geojson.tar.gz meta_dcat_hh_catastrorural_midagri.json -C derived hh_catastrorural_midagri.json\n  \n  # Move into correct directory\n  cd /data/hh_catastrorural_midagri/"
        },
