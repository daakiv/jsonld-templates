      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_bus_stops",
      "name": "Miami-Dade Bus Stops",
      "description": "A point feature class of the Miami-Dade County Bus Stops.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "821K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_bus_stops"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "40"
