  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_county_zoning",
      "name": "Miami-Dade County Zoning",
      "description": "A polygon feature class of the county zoning boundaries and overlays derived from the zoning maps and other layers from the parcel model.\n  \n  This dataset should not be used for applications requiring accurate plat survey information such as zone and overlay dimension and area.\n  \n  Updated: Weekly-Sat",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "9.3M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_county_zoning"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "59"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_county_zoning/download -p /data/mdc_county_zoning/etl\n  chmod 777 /data/mdc_county_zoning/download\n  cd /data/mdc_county_zoning\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln mdc_county_zoning download/mdc_county_zoning.json 'https://gisweb.miamidade.gov/arcgis/rest/services/LandManagement/MD_Zoning/MapServer/1/query?where=1%3D1&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_county_zoning.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_county_zoning.json -nlt multipolygon -nln mdc_county_zoning\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_county_zoning\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_county_zoning',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_county_zoning\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_county_zoning_geom_local_idx\n    ON mdc_county_zoning\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "zone"
        },
        {
          "@type": "PropertyValue",
          "name": "values",
          "value": "munc"
        },
        {
          "@type": "PropertyValue",
          "name": "analytic_function",
          "value": "gdsc_get_attributes"
        },
        {
          "@type": "PropertyValue",
          "name": "Spatial Reference System",
          "value": "http://www.opengis.net/def/crs/EPSG/0/2236"
        },
        {
          "@type": "PropertyValue",
          "name": "download_method",
          "value": "esri_recursive_ogr"
        },
        {
          "@type": "PropertyValue",
          "name": "source_file",
          "value": "{'etl_group/file_name_group/file_name_value': 'mdc_county_zoning'}"
