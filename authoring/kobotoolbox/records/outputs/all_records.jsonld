  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_holc_redlining",
      "name": "Miami-Dade Home Owner's Loan Corporation (HOLC) Neighborhood Redlining Grade",
      "description": "The historical redlining grade from 143 cities across the United States. This dataset is the subset for Miami-Dade County in Florida.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "119K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_holc_redlining"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "1"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_holc_redlining/download -p /data/mdc_holc_redlining/etl\n  chmod 777 /data/mdc_holc_redlining/download\n  cd /data/mdc_holc_redlining\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln mdc_holc_redlining download/mdc_holc_redlining.geojson 'https://services.arcgis.com/jIL9msH9OI208GCb/ArcGIS/rest/services/HOLC_Neighborhood_Redlining/FeatureServer/0/query?where=city=%27Miami%27&outFields=*&outSR=4326&f=json'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_holc_redlining.geojson\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_holc_redlining.geojson -nlt multipolygon -nln mdc_holc_redlining\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_holc_redlining\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_holc_redlining',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_holc_redlining\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_holc_redlining_geom_local_idx\n    ON mdc_holc_redlining\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_holc_redlining/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_holc_redlining/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-14tphzahiyxfy9tf -t mdc_holc_redlining > derived/mdc_holc_redlining.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_holc_redlining.sql.tar.gz\n  tar -czf derived/mdc_holc_redlining.sql.tar.gz meta_dcat_mdc_holc_redlining.json -C derived mdc_holc_redlining.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "holc_grade"
        },
        {
          "@type": "PropertyValue",
          "name": "values",
          "value": "holc"
        },
        {
          "@type": "PropertyValue",
          "name": "analytic_function",
          "value": "gdsc_get_attributes gdsc_nearest_neighbor"
        },
        {
          "@type": "PropertyValue",
          "name": "Spatial Reference System",
          "value": "http://www.opengis.net/def/crs/EPSG/0/2236"
        },
        {
          "@type": "PropertyValue",
          "name": "derivatives",
          "value": "sql"
        },
        {
          "@type": "PropertyValue",
          "name": "download_method",
          "value": "esri_recursive_ogr"
        },
