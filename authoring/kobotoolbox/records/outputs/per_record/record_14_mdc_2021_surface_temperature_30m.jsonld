      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_2021_surface_temperature_30m",
      "name": "Miami-Dade Surface Temperature (degrees Fahrenheit)",
      "description": "Max Landsat 8 ARD (Analysis Ready Data) Surface Temperature from 7 different images ranging from 2011-2020.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "510M"
        },
        {
          "@type": "PropertyValue",
