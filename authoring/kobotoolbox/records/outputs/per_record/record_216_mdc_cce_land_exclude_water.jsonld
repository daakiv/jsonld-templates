        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_cce_land_exclude_water/download -p /data/mdc_cce_land_exclude_water/etl\n  chmod 777 /data/mdc_cce_land_exclude_water/download\n  cd /data/mdc_cce_land_exclude_water\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # remove spaces for all column headers in csv\n    sed -i '1 s/ /_/g' download/mdc_cce_land_exclude_water.csv\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_cce_land_exclude_water.csv -nln mdc_cce_land_exclude_water"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "values",
          "value": "folio"
        },
        {
          "@type": "PropertyValue",
          "name": "download_method",
          "value": "local"
        },
        {
