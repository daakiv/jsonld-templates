          "name": "kobo_record_id",
          "value": "209"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_2023_bofedales_inaigem/download -p /data/hh_2023_bofedales_inaigem/etl\n  chmod 777 /data/hh_2023_bofedales_inaigem/download\n  cd /data/hh_2023_bofedales_inaigem\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  curl -o download/hh_2023_bofedales_inaigem.json 'https://datacochageoespacial.inaigem.gob.pe/geoserver/inventario_bofedales/ows?service=WFS&version=1.0.0&request=GetFeature&typeName=inventario_bofedales%3Ainventario_bofedales_2023&outputFormat=application/json&bbox=-77.33,-10.7,-76.55,-9.8,EPSG:4326'\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_2023_bofedales_inaigem.json -nlt multipolygon -nln hh_2023_bofedales_inaigem\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_2023_bofedales_inaigem\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_2023_bofedales_inaigem',\n    'geom_local', 5387, 'multipolygon', 2\n  );\n  UPDATE hh_2023_bofedales_inaigem\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_2023_bofedales_inaigem_geom_local_idx\n    ON hh_2023_bofedales_inaigem\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_2023_bofedales_inaigem/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_2023_bofedales_inaigem.shp PG:\"<postgres connection>\" hh_2023_bofedales_inaigem\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_2023_bofedales_inaigem.shp.tar.gz\n  tar -czf derived/hh_2023_bofedales_inaigem.shp.tar.gz meta_dcat_hh_2023_bofedales_inaigem.json -C derived hh_2023_bofedales_inaigem.shp hh_2023_bofedales_inaigem.prj hh_2023_bofedales_inaigem.shx hh_2023_bofedales_inaigem.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_2023_bofedales_inaigem.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_2023_bofedales_inaigem.gpkg PG:\"<postgres connection>\" -select \"objectid,fid_invent,desc_cober,zona_utm,macrozona,vertiente,ubig_dep,nomb_dep,ubig_prov,nomb_prov,ubig_dist,nomb_dist,nomb_capdi,cod_uh,nomb_uh,area_ha,geom\" hh_2023_bofedales_inaigem\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_2023_bofedales_inaigem.gpkg.tar.gz\n  tar -czf derived/hh_2023_bofedales_inaigem.gpkg.tar.gz meta_dcat_hh_2023_bofedales_inaigem.json -C derived hh_2023_bofedales_inaigem.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_2023_bofedales_inaigem.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_2023_bofedales_inaigem.json PG:\"<postgres connection>\" -select \"objectid,fid_invent,desc_cober,zona_utm,macrozona,vertiente,ubig_dep,nomb_dep,ubig_prov,nomb_prov,ubig_dist,nomb_dist,nomb_capdi,cod_uh,nomb_uh,area_ha,geom\" hh_2023_bofedales_inaigem\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_2023_bofedales_inaigem.geojson.tar.gz\n  tar -czf derived/hh_2023_bofedales_inaigem.geojson.tar.gz meta_dcat_hh_2023_bofedales_inaigem.json -C derived hh_2023_bofedales_inaigem.json\n  \n  # Move into correct directory\n  cd /data/hh_2023_bofedales_inaigem/"
        },
