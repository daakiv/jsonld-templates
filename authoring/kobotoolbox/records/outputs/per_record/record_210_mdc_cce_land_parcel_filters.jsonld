      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_cce_land_parcel_filters",
      "name": "CCE Miami-Dade Parcel Filters",
      "description": "The exclude and incluude filters for the MAP parcel data.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "1.6M"
        },
