    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_comission_districts",
      "name": "Miami-Dade County Comission Districts",
      "description": "A polygon feature class representing the Miami-Dade County Commission District boundaries.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "0"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_comission_districts"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "171"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_comission_districts/download -p /data/mdc_comission_districts/etl\n  chmod 777 /data/mdc_comission_districts/download\n  cd /data/mdc_comission_districts\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln mdc_comission_districts download/mdc_comission_districts.json 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/CommissionDistrict_gdb/FeatureServer/0/query?outFields=*&where=1%3D1&f=geojson'\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_comission_districts.json -nlt multipolygon -nln mdc_comission_districts\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_comission_districts\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_comission_districts',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_comission_districts\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_comission_districts_geom_local_idx\n    ON mdc_comission_districts\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "id"
        },
        {
          "@type": "PropertyValue",
          "name": "Spatial Reference System",
          "value": "http://www.opengis.net/def/crs/EPSG/0/2236"
        },
        {
