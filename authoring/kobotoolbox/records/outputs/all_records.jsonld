    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_federally_qualified_health_centers",
      "name": "Miami-Dade Federally Qualified Health Centers",
      "description": "A point feature class of Federally Qualified Health Centers within Miami-Dade County.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "7.5K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_federally_qualified_health_centers"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "25"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_federally_qualified_health_centers/download -p /data/mdc_federally_qualified_health_centers/etl\n  chmod 777 /data/mdc_federally_qualified_health_centers/download\n  cd /data/mdc_federally_qualified_health_centers\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_federally_qualified_health_centers.json 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/FederallyQualifiedHealthCenter_gdb/FeatureServer/0/query?where=1%3D1&outFields=*&outSR=4326&f=json'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_federally_qualified_health_centers.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_federally_qualified_health_centers.json -nlt point -nln mdc_federally_qualified_health_centers\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_federally_qualified_health_centers\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_federally_qualified_health_centers',\n    'geom_local', 2236, 'point', 2\n  );\n  UPDATE mdc_federally_qualified_health_centers\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,2236)));\n  CREATE INDEX mdc_federally_qualified_health_centers_geom_local_idx\n    ON mdc_federally_qualified_health_centers\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_federally_qualified_health_centers/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_federally_qualified_health_centers/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-choyl8g6pi0bysn7 -t mdc_federally_qualified_health_centers > derived/mdc_federally_qualified_health_centers.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_federally_qualified_health_centers.sql.tar.gz\n  tar -czf derived/mdc_federally_qualified_health_centers.sql.tar.gz meta_dcat_mdc_federally_qualified_health_centers.json -C derived mdc_federally_qualified_health_centers.sql"
        },
