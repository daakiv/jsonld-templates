          "value": "{'etl_group/file_name_group/file_inside_archive': 'VNP46A4.A2019001.h09v06.002.2025134123459', 'etl_group/file_name_group/file_name_value': 'mdc_2019_viirs_vnp46a4'}"
        },
        {
