          "name": "postgis_table",
          "value": "mdc_2021_nlcd_tcc_v2023_5"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "262"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2021_nlcd_tcc_v2023_5/download -p /data/mdc_2021_nlcd_tcc_v2023_5/etl\n  chmod 777 /data/mdc_2021_nlcd_tcc_v2023_5/download\n  cd /data/mdc_2021_nlcd_tcc_v2023_5\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # load us_2021_nlcd_tcc_v2023_5 as dependency (see us_2021_nlcd_tcc_v2023_5 for details).\n  \n  # load fl_2022_tl_cousub as dependency (see fl_2022_tl_cousub for details).\n  \n  # clip raster with geometry as:\n    gdalwarp -cutline PG:\"<postgres connection>\" -csql \"SELECT geom FROM fl_2022_tl_cousub WHERE countyfp='086'\" -crop_to_cutline -s_srs EPSG:5070 -t_srs EPSG:4326 /data/us_2021_nlcd_tcc_v2023_5/download/nlcd_tcc_conus_wgs84_v2023-5_20210101_20211231.tif download/mdc_2021_nlcd_tcc_v2023_5.tif\n   \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 4326 -d -C -I -t 48x48 mdc_2021_nlcd_tcc_v2023_5.tif -F mdc_2021_nlcd_tcc_v2023_5 > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # create color raster\n  mkdir -p /tiles/raster/mdc_2021_nlcd_tcc_v2023_5\n  mkdir -p /data/mdc_2021_nlcd_tcc_v2023_5/derived\n  cd /data/mdc_2021_nlcd_tcc_v2023_5\n  cat > /data/mdc_2021_nlcd_tcc_v2023_5/derived/mdc_2021_nlcd_tcc_v2023_5_color_ramp.txt <<_EOF\n  nv 0 0 0 0\n  255 255 255 255 0\n  100 0 68 27 255\n  90 0 109 44 255\n  80 29 134 65 255\n  70 53 159 84 255\n  60 85 181 103 255\n  50 123 199 124 255\n  40 158 215 152 255\n  30 187 228 181 255\n  20 213 239 207 255\n  10 233 247 229 255\n  0 255 255 255 0\n  _EOF\n  gdaldem color-relief download/mdc_2021_nlcd_tcc_v2023_5.tif /data/mdc_2021_nlcd_tcc_v2023_5/derived/mdc_2021_nlcd_tcc_v2023_5_color_ramp.txt /data/mdc_2021_nlcd_tcc_v2023_5/derived/mdc_2021_nlcd_tcc_v2023_5_color.tif -alpha\n  # create color raster and render raster tiles \n  mkdir -p /data/mdc_2021_nlcd_tcc_v2023_5/derived\n  mkdir -p /tiles/raster/mdc_2021_nlcd_tcc_v2023_5\n  cd /data/mdc_2021_nlcd_tcc_v2023_5\n  echo \"\" | base64 -d > /data/mdc_2021_nlcd_tcc_v2023_5/derived/mdc_2021_nlcd_tcc_v2023_5_legend.png\n  cp /data/mdc_2021_nlcd_tcc_v2023_5/derived/mdc_2021_nlcd_tcc_v2023_5_legend.png /tiles/raster/mdc_2021_nlcd_tcc_v2023_5/\n  # render raster tiles \n  cd /data/mdc_2021_nlcd_tcc_v2023_5/\n  gdal2tiles.py -ex --xyz -z 8-16 /data/mdc_2021_nlcd_tcc_v2023_5/derived/mdc_2021_nlcd_tcc_v2023_5_color.tif /tiles/raster/mdc_2021_nlcd_tcc_v2023_5"
        },
