    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_dem_copernicus",
      "name": "Huayhuash DEM 10m (Copernicus)",
      "description": "A raster dataset with yearly averages of the 2m temperature from the ERA 5 renanalysis data from Copernicus satellite sensors for Tanzania. ERA5 is the fifth generation ECMWF reanalysis for the global climate and weather for the past 8 decades. Data is available from 1940 onwards. ERA5 replaces the ERA-Interim reanalysis.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "0"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_dem_copernicus"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "323"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_dem_copernicus/download -p /data/hh_dem_copernicus/etl\n  chmod 777 /data/hh_dem_copernicus/download\n  cd /data/hh_dem_copernicus\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # clone a git repo and run the code# save netcdf as tif\n  cd download\n  gdal_translate NETCDF:hh_dem_copernicus.nc:2m_temperature hh_dem_copernicus.tif\n  cd ..\n  \n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 4326 -d -C -I -t auto hh_dem_copernicus.tif -F hh_dem_copernicus > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_dem_copernicus/\n  mkdir -p derived\n  \n  # Create downloadable zip of download/geotiff in derivate directory \n  rm -f derived/hh_dem_copernicus.tif.tar.gz\n  tar -czf derived/hh_dem_copernicus.tif.tar.gz meta_dcat_hh_dem_copernicus.json -C download hh_dem_copernicus.tif\n  \n  # Move into correct directory\n  cd /data/hh_dem_copernicus/"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
