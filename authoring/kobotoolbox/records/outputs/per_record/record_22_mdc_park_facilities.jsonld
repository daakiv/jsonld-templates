  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_park_facilities",
      "name": "Miami-Dade Park Facilities",
      "description": "A point feature class of all park facilities (County, Municipal, State or National) within Miami-Dade County. This layer was created merging the County Parks, Municipal Parks, State and Federal parks feature classes. ",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "1.4M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_park_facilities"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "22"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_park_facilities/download -p /data/mdc_park_facilities/etl\n  chmod 777 /data/mdc_park_facilities/download\n  cd /data/mdc_park_facilities\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_park_facilities.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_park_facilities.json -nlt point -nln mdc_park_facilities\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_park_facilities\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_park_facilities',\n    'geom_local', 2236, 'point', 2\n  );\n  UPDATE mdc_park_facilities\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,2236)));\n  CREATE INDEX mdc_park_facilities_geom_local_idx\n    ON mdc_park_facilities\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_park_facilities/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_park_facilities/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-6ekphs9xbsgg4yy4 -t mdc_park_facilities > derived/mdc_park_facilities.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_park_facilities.sql.tar.gz\n  tar -czf derived/mdc_park_facilities.sql.tar.gz meta_dcat_mdc_park_facilities.json -C derived mdc_park_facilities.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "name"
        },
        {
          "@type": "PropertyValue",
          "name": "analytic_function",
          "value": "gdsc_count_within gdsc_nearest_neighbor"
        },
