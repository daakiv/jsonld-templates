          "value": "{'etl_group/file_name_group/file_name_value': 'tz_populated_places_osm'}"
        },
        {
          "@type": "PropertyValue",
          "name": "podid",
          "value": "gaia-db"
        },
        {
          "@type": "PropertyValue",
