  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/com_comission_districts",
      "name": "City of Miami Comission Districts",
      "description": "This data is used to display the geogrpahic boundaries of the commission districts and to help manage and facitlitate administrative tasks.\n  \n  The Commission Districts dataset is a spatial data representation of the five districts of City of Miami, originally created by the City Clerk's Office, City of Miami. Each district is administered by a commissioner, which is elected every four years. The data layer is maintained and managed by the GIS Team of the City of Miami.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "0\n    du: cannot access '/data/com_comission_districts/': No such file or directory"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "com_comission_districts"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "172"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/com_comission_districts/download -p /data/com_comission_districts/etl\n  chmod 777 /data/com_comission_districts/download\n  cd /data/com_comission_districts\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln com_comission_districts download/com_comission_districts.json 'https://services1.arcgis.com/CvuPhqcTQpZPT9qY/arcgis/rest/services/Commission_Districts/FeatureServer/0/query?outFields=*&where=1%3D1&f=geojson'\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/com_comission_districts.json -nlt multipolygon -nln com_comission_districts\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE com_comission_districts\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'com_comission_districts',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE com_comission_districts\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX com_comission_districts_geom_local_idx\n    ON com_comission_districts\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
