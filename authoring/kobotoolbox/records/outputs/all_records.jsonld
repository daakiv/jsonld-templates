          "qudt:dataType": "xsd:float8",
          "unitText": "moe",
          "sourceOrganization": {
            "@type": "Organization",
            "name": "((SQRT(M_POV150^2-((EP_POV150 / 100)^2 * S1701_C01_001M ^2))) / S1701_C01_001E) * 100"
          }
        },
        {
          "@type": "PropertyValue",
          "name": "\n    mp_sngpnt",
          "description": "Percentage of single-parent households with children under 18 estimate MOE, 2016-2020 ACS",
