    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_rutas_pie_osm",
      "name": "OSM Huayhuash Rutas a Pie",
      "description": "A line feature set for the walking trails of the Cordillera Huayhuash sourced from OpenStreetMap with a query that includes paths, trails, and apline routes",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "9.4M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_rutas_pie_osm"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "317"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_rutas_pie_osm/download -p /data/hh_rutas_pie_osm/etl\n  chmod 777 /data/hh_rutas_pie_osm/download\n  cd /data/hh_rutas_pie_osm\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  curl -o download/hh_rutas_pie_osm.osm 'https://overpass-api.de/api/interpreter?data=%28nwr%5B%22highway%22=%22path%22%5D%28-10.7,-77.33,-9.8,-76.55%29;nwr%5B%22highway%22=%22footway%22%5D%5B%22footway%22=%22trail%22%5D%28-10.7,-77.33,-9.8,-76.55%29;nwr%5B%22route%22=%22hiking%22%5D%28-10.7,-77.33,-9.8,-76.55%29;%29;%28._;>;%29;out;'\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_rutas_pie_osm.osm\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # Select proper geometry into the named table\n  psql -d $POSTGRES_DB -U $POSTGRES_USER -p $POSTGRES_PORT -h gdsc-postgis-node-u9yylpopgjgvfqub -c \"\n  SELECT * INTO hh_rutas_pie_osm FROM lines;\n  DROP TABLE IF EXISTS lines;\n  DROP TABLE IF EXISTS multilinestrings;\n  DROP TABLE IF EXISTS multipolygons;\n  DROP TABLE IF EXISTS other_relations;\n  DROP TABLE IF EXISTS points;\"\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_rutas_pie_osm\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_rutas_pie_osm',\n    'geom_local', 5387, 'multilinestring', 2\n  );\n  UPDATE hh_rutas_pie_osm\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_rutas_pie_osm_geom_local_idx\n    ON hh_rutas_pie_osm\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_rutas_pie_osm/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_rutas_pie_osm.shp PG:\"<postgres connection>\" hh_rutas_pie_osm\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_rutas_pie_osm.shp.tar.gz\n  tar -czf derived/hh_rutas_pie_osm.shp.tar.gz meta_dcat_hh_rutas_pie_osm.json -C derived hh_rutas_pie_osm.shp hh_rutas_pie_osm.prj hh_rutas_pie_osm.shx hh_rutas_pie_osm.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_rutas_pie_osm.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_rutas_pie_osm.gpkg PG:\"<postgres connection>\" -select \"osm_id,name,highway,other_tags,geom\" hh_rutas_pie_osm\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_rutas_pie_osm.gpkg.tar.gz\n  tar -czf derived/hh_rutas_pie_osm.gpkg.tar.gz meta_dcat_hh_rutas_pie_osm.json -C derived hh_rutas_pie_osm.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_rutas_pie_osm.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_rutas_pie_osm.json PG:\"<postgres connection>\" -select \"osm_id,name,highway,other_tags,geom\" hh_rutas_pie_osm\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_rutas_pie_osm.geojson.tar.gz\n  tar -czf derived/hh_rutas_pie_osm.geojson.tar.gz meta_dcat_hh_rutas_pie_osm.json -C derived hh_rutas_pie_osm.json\n  \n  # Move into correct directory\n  cd /data/hh_rutas_pie_osm/"
        },
