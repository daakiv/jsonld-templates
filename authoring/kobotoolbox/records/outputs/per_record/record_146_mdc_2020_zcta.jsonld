      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_2020_zcta",
      "name": "Miami-Dade 2020 Zip Code Tabulation Areas",
      "description": "A polygon representation of the Miami-Dade Zip Code Tabulation Areas (ZCTA) boundaries (derived from us_2020_zcta).",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "1.7M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_2020_zcta"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "146"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2020_zcta/download -p /data/mdc_2020_zcta/etl\n  chmod 777 /data/mdc_2020_zcta/download\n  cd /data/mdc_2020_zcta\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # load us_2020_zcta as dependency (see us_2020_zcta for details).\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_2020_zcta.shp -nlt multipolygon -nln mdc_2020_zcta\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_2020_zcta\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_2020_zcta',\n    'geom_local', 4269, 'multipolygon', 2\n  );\n  UPDATE mdc_2020_zcta\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),4269)));\n  CREATE INDEX mdc_2020_zcta_geom_local_idx\n    ON mdc_2020_zcta\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "geoid20"
        },
        {
          "@type": "PropertyValue",
          "name": "analytic_function",
          "value": "gdsc_get_attributes"
        },
        {
