  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/hh_redhidrica_idep",
      "name": "Red Hídrica Huayhuash (IDEP 100000)",
      "description": "Una inventario de la red hidrica en la Cordillera Huayhuash. Fuente: Instituo Geografica Nacional del Peru por la Infraestructura de Datos Espaciales del Perú (IDEP).",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "4.9M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "hh_redhidrica_idep"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "190"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/hh_redhidrica_idep/download -p /data/hh_redhidrica_idep/etl\n  chmod 777 /data/hh_redhidrica_idep/download\n  cd /data/hh_redhidrica_idep\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  ogr2ogr -nln hh_redhidrica_idep download/hh_redhidrica_idep.json 'https://www.idep.gob.pe/geoportal/rest/services/SERVICIOS_IGN/HIDROGRAFIA_100K/MapServer/0/query?where=1%3D1&geometry=%22xmin%22%3A-77.33%2C%22ymin%22%3A-10.7%2C%22xmax%22%3A-76.55%2C%22ymax%22%3A-9.8&geometryType=esriGeometryEnvelope&inSR=4326&spatialRel=esriSpatialRelIntersects&outFields=*&returnGeometry=true&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/hh_redhidrica_idep.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/hh_redhidrica_idep.json -nlt multilinestring -nln hh_redhidrica_idep\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE hh_redhidrica_idep\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'hh_redhidrica_idep',\n    'geom_local', 5387, 'multilinestring', 2\n  );\n  UPDATE hh_redhidrica_idep\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),5387)));\n  CREATE INDEX hh_redhidrica_idep_geom_local_idx\n    ON hh_redhidrica_idep\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/hh_redhidrica_idep/\n  mkdir -p derived\n  \n  # Create shapefile of table in derivate directory on osgeo \n  ogr2ogr -f \"ESRI Shapefile\" -overwrite derived/hh_redhidrica_idep.shp PG:\"<postgres connection>\" hh_redhidrica_idep\n  \n  # Create downloadable tarfile of shp in derivative directory on osgeo\n  rm -f derived/hh_redhidrica_idep.shp.tar.gz\n  tar -czf derived/hh_redhidrica_idep.shp.tar.gz meta_dcat_hh_redhidrica_idep.json -C derived hh_redhidrica_idep.shp hh_redhidrica_idep.prj hh_redhidrica_idep.shx hh_redhidrica_idep.dbf\n  \n  # Create gpkg of table in derivate directory on osgeo \n  rm -f derived/hh_redhidrica_idep.gpkg\n  ogr2ogr -f GPKG -overwrite derived/hh_redhidrica_idep.gpkg PG:\"<postgres connection>\" -select \"longitud,objectid,rasgo_prin,rasgo_secu,nombre,cuenca,caract,obs,provincia,dpto,distrito,cod_facc,cod_ign,geom\" hh_redhidrica_idep\n  \n  # Create downloadable tarfile of gpkg in derivative directory on osgeo\n  rm -f derived/hh_redhidrica_idep.gpkg.tar.gz\n  tar -czf derived/hh_redhidrica_idep.gpkg.tar.gz meta_dcat_hh_redhidrica_idep.json -C derived hh_redhidrica_idep.gpkg\n  \n  # Create geojson of table in derivate directory on osgeo \n  rm -f derived/hh_redhidrica_idep.json\n  ogr2ogr -f GeoJSON -overwrite derived/hh_redhidrica_idep.json PG:\"<postgres connection>\" -select \"longitud,objectid,rasgo_prin,rasgo_secu,nombre,cuenca,caract,obs,provincia,dpto,distrito,cod_facc,cod_ign,geom\" hh_redhidrica_idep\n  \n  # Create downloadable tarfile of geojson in derivative directory on osgeo\n  rm -f derived/hh_redhidrica_idep.geojson.tar.gz\n  tar -czf derived/hh_redhidrica_idep.geojson.tar.gz meta_dcat_hh_redhidrica_idep.json -C derived hh_redhidrica_idep.json\n  \n  # Move into correct directory\n  cd /data/hh_redhidrica_idep/"
        },
