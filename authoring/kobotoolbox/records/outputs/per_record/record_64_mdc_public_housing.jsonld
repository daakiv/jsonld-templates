  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_public_housing",
      "name": "Miami-Dade County Public Housing Developments",
      "description": "Denotes the general position of Public Housing Developments by providing the location of the building with the largest number of units in a Development’s community.\n  \n  HUD furnishes technical and professional assistance in planning, developing and managing these developments. Public Housing Developments are depicted as a distinct address chosen to represent the general location of an entire Public Housing Development, which may be comprised of several buildings scattered across a community. The building with the largest number of units is selected to represent the location of the development. \n  ",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "161K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_public_housing"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "64"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_public_housing/download -p /data/mdc_public_housing/etl\n  chmod 777 /data/mdc_public_housing/download\n  cd /data/mdc_public_housing\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_public_housing.json 'https://services.arcgis.com/VTyQ9soqVukalItT/arcgis/rest/services/Public_Housing_Developments/FeatureServer/0/query?outFields=*&where=COUNTY_LEVEL%3D12086&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_public_housing.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_public_housing.json -nlt point -nln mdc_public_housing\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_public_housing\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_public_housing',\n    'geom_local', 2236, 'point', 2\n  );\n  UPDATE mdc_public_housing\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(geom,2236)));\n  CREATE INDEX mdc_public_housing_geom_local_idx\n    ON mdc_public_housing\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_public_housing/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_public_housing/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-tyj0rg8e6ddooiz7 -t mdc_public_housing > derived/mdc_public_housing.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_public_housing.sql.tar.gz\n  tar -czf derived/mdc_public_housing.sql.tar.gz meta_dcat_mdc_public_housing.json -C derived mdc_public_housing.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
