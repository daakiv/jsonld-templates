    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_distance_to_parks",
      "name": "Miami-Dade County Distance to Parks",
      "description": "A raster of the euclidean distance from parks within Miami-Dade County.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "510M"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_distance_to_parks"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "130"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "person"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_2021_hylo/download -p /data/mdc_2021_hylo/mdc_distance_to_parks/etl\n  chmod 777 /data/mdc_2021_hylo/download\n  cd /data/mdc_2021_hylo\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_2021_hylo.zip 'https://scholarship.miami.edu/view/fileRedirect?instCode=01UOML_INST&filePid=13395678880002976&download=true'\n  \n  # unzip to download directory if update flag is set\n  if do_update == 1 then\n  unzip -d download download/mdc_2021_hylo.zip && rm download/mdc_2021_hylo.zip\n  \n  # load raster into postGIS with:\n      raster2pgsql -s 3857 -d -C -I -t 48x48 GeoTIFF_Rasters/Parks_Euclid_Dist_30m_MDC.tif -F mdc_distance_to_parks > load_raster.sql\n  psql <connection options> < load_raster.sql\n  rm load_raster.sql\n  \n  # create color raster\n  mkdir -p /tiles/raster/mdc_distance_to_parks\n  mkdir -p /data/mdc_2021_hylo/mdc_distance_to_parks/derived\n  cd /data/mdc_2021_hylo\n  cat > /data/mdc_2021_hylo/mdc_distance_to_parks/derived/mdc_distance_to_parks_color_ramp.txt <<_EOF\n  0 159 212 140 255\n  150 158 211 139 230\n  330 157 210 138 199\n  525 156 209 136 166\n  720 155 208 135 133\n  915 154 207 134 99\n  1110 152 206 133 66\n  1305 151 205 131 33\n  1500 150 204 130 0\n  _EOF\n  gdaldem color-relief download/GeoTIFF_Rasters/Parks_Euclid_Dist_30m_MDC.tif /data/mdc_2021_hylo/mdc_distance_to_parks/derived/mdc_distance_to_parks_color_ramp.txt /data/mdc_2021_hylo/mdc_distance_to_parks/derived/mdc_distance_to_parks_color.tif -alpha\n  # create color raster and render raster tiles \n  mkdir -p /data/mdc_2021_hylo/mdc_distance_to_parks/derived\n  mkdir -p /tiles/raster/mdc_distance_to_parks\n  cd /data/mdc_2021_hylo\n  echo \"\" | base64 -d > /data/mdc_2021_hylo/mdc_distance_to_parks/derived/mdc_distance_to_parks_legend.png\n  cp /data/mdc_2021_hylo/mdc_distance_to_parks/derived/mdc_distance_to_parks_legend.png /tiles/raster/mdc_distance_to_parks/\n  # render raster tiles \n  cd /data/mdc_2021_hylo/mdc_distance_to_parks/\n  gdal2tiles.py -ex --xyz -z 8-16 /data/mdc_2021_hylo/mdc_distance_to_parks/derived/mdc_distance_to_parks_color.tif /tiles/raster/mdc_distance_to_parks"
        },
        {
