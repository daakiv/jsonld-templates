  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_community_redevelopment_agency",
      "name": "Miami-Dade Community Redevelopment Areas",
      "description": "A polygon feature class of the Miami-Dade County Community Redevelopment Areas (CRA). This data is frequently used by Department of Planning and Zoning (DP&Z) and Community Planners in their planning function and studies.",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "0"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_community_redevelopment_agency"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "63"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_community_redevelopment_agency/download -p /data/mdc_community_redevelopment_agency/etl\n  chmod 777 /data/mdc_community_redevelopment_agency/download\n  cd /data/mdc_community_redevelopment_agency\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_community_redevelopment_agency.json 'https://services.arcgis.com/8Pc9XBTAsYuxx9Ny/arcgis/rest/services/CommunityRedevelopmentArea_gdb/FeatureServer/0/query?outFields=*&where=1%3D1&outSR=4326&f=geojson'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_community_redevelopment_agency.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_community_redevelopment_agency.json -nlt multipolygon -nln mdc_community_redevelopment_agency\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_community_redevelopment_agency\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_community_redevelopment_agency',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_community_redevelopment_agency\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_community_redevelopment_agency_geom_local_idx\n    ON mdc_community_redevelopment_agency\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';\n  # Move into corrrect directory and create derivative directory in data package on osgeo\n  cd /data/mdc_community_redevelopment_agency/\n  mkdir -p derived\n  \n  # Move into correct directory\n  cd /data/mdc_community_redevelopment_agency/\n  \n  # Create pg_dump of table SQL in derivate directory on postgis.\n  pg_dump <postgres opts> -h gdsc-postgis-node-cquq818ti45mubqs -t mdc_community_redevelopment_agency > derived/mdc_community_redevelopment_agency.sql\n  \n  # Create downloadable tarfile of SQL in derivative directory on postgis\n  rm -f derived/mdc_community_redevelopment_agency.sql.tar.gz\n  tar -czf derived/mdc_community_redevelopment_agency.sql.tar.gz meta_dcat_mdc_community_redevelopment_agency.json -C derived mdc_community_redevelopment_agency.sql"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
