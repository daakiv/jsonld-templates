  "@graph": [
    {
      "@type": "schema:Dataset",
      "@id": "https://gdsc.idsc.miami.edu/detail/mdc_parcels",
      "name": "Miami-Dade Parcels",
      "description": "A polygon feature class of the property ownership boundaries as defined by legal description and deeds.Used for Maintaining property boundaries throughout Miami-Dade County.\n  \n  A polygon feature class of the property ownership boundaries as defined by legal description and deeds. Used for Maintaining property boundaries throughout Miami-Dade County.\n  \n  Updated: Weekly-Sat\n  \n  The data was created using:\n  Projected Coordinate System: WGS_1984_Web_Mercator_Auxiliary_Sphere\n  Projection: Mercator_Auxiliary_Sphere",
      "additionalProperty": [
        {
          "@type": "PropertyValue",
          "name": "size",
          "value": "6.1K"
        },
        {
          "@type": "PropertyValue",
          "name": "postgis_table",
          "value": "mdc_parcels"
        },
        {
          "@type": "PropertyValue",
          "name": "kobo_record_id",
          "value": "57"
        },
        {
          "@type": "PropertyValue",
          "name": "creator_type",
          "value": "organization"
        },
        {
          "@type": "PropertyValue",
          "name": "process_step",
          "value": "#########\n  # GDSC ETL is performed in two steps: shell script to ETL data into postgres\n  # and then additional transformations with SQL in postGIS (if needed).\n  ####\n  \n  #########\n  # Step 1 - bash script (pseudo code)\n  ####\n  \n  # create directory structure and move into it\n  mkdir -p /data/mdc_parcels/download -p /data/mdc_parcels/etl\n  chmod 777 /data/mdc_parcels/download\n  cd /data/mdc_parcels\n  \n  # set update flag based on last update and update frequency\n  do_update=0 if date() < last_update + update_frequency else do_update = 1\n  \n  # download if update flag is set:\n  if do_update == 1 then\n  wget -O download/mdc_parcels.json 'https://opendata.arcgis.com/api/v3/datasets/347bce97227c4b54b04a3e626b558950_0/downloads/data?format=geojson&spatialRefId=4326&where=1%3D1'\n  \n  # replace column names Shape__Length and Shape__Area to avoid conflict when\n  # providing as service on ArcServer.\n  sed -i 's/Shape__Length/shape_length/gI; s/Shape__Area/shape_area/gI' download/mdc_parcels.json\n  \n  # load into postGIS with:\n    ogr2ogr -lco GEOMETRY_NAME=geom -f PostgreSQL PG:\"<postgres connection>\" download/mdc_parcels.json -nlt multipolygon -nln mdc_parcels\n  \n  #########\n  # Step 2 - SQL script (pseudo code):\n  ####\n  \n  # remove duplicate points and make geometries valid:\n  UPDATE mdc_parcels\n    SET geom=ST_MakeValid(ST_RemoveRepeatedPoints(geom));\n  \n  # add local geometry column and reproject existing geometries into local EPSG:\n  SELECT AddGeometryColumn (\n    'mdc_parcels',\n    'geom_local', 2236, 'multipolygon', 2\n  );\n  UPDATE mdc_parcels\n    SET geom_local=ST_MakeValid(ST_RemoveRepeatedPoints(ST_Transform(ST_Multi(geom),2236)));\n  CREATE INDEX mdc_parcels_geom_local_idx\n    ON mdc_parcels\n    USING GIST (geom_local);\n  NOTIFY pgrst, 'reload schema';"
        },
        {
          "@type": "PropertyValue",
          "name": "processor",
          "value": "GDSC automation (see Process Step)"
        },
        {
          "@type": "PropertyValue",
          "name": "label",
          "value": "folio"
        },
        {
          "@type": "PropertyValue",
          "name": "values",
          "value": "subcode"
        },
        {
